  <!-- Meeting Schedule -->
  <div class="container">
    <h1>Sales Report</h1>
    <div class="summary">
        <div class="summary-box">
            <h2><%= totalOrders %></h2>
            <p>Total Orders</p>
        </div>
        <div class="summary-box">
            <h2>₹<%= totalDiscount.toFixed(2) %></h2>
            <p>Total Discount(₹)</p>
        </div>
        <div class="summary-box">
            <h2>₹<%= totalSalesAmount.toFixed(2) %></h2>
            <p>Total Sales Amount(₹)</p>
        </div>
    </div>

    <div class="filters">
        <label for="filter">Filters:</label>
        <select id="filter">
            <option value="daily" <% if (filter === 'daily') { %> selected <% } %>>Daily</option>
            <option value="weekly" <% if (filter === 'weekly') { %> selected <% } %>>Weekly</option>
            <option value="monthly" <% if (filter === 'monthly') { %> selected <% } %>>Monthly</option>
            <option value="custom" <% if (filter === 'custom') { %> selected <% } %>>Custom</option>
        </select>

        <div id="custom-date-range" class="<% if (filter === 'custom') { %> hidden <% } %>">
            <label for="start-date" class="date-label">Start Date:</label>
            <input type="date" id="start-date" name="start-date" class="date-input" value="<%= startDate %>">

            <label for="end-date" class="date-label">End Date:</label>
            <input type="date" id="end-date" name="end-date" class="date-input" value="<%= endDate %>">
        </div>

        <div class="export">
            <button class="pdf">PDF</button>
            <button class="excel">Excel</button>
        </div>

        <button class="generate">+ Generate</button>
    </div>

    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Total</th>
                    <th>Discount</th>
                </tr>
            </thead>
            <tbody>
                <% let grandTotal = 0; %>
                <% if (typeof orders === 'undefined' || orders.length === 0) { %>
                    <tr>
                        <td colspan="7">No orders found for this user.</td>
                    </tr>
                <% } else { %>
                    <% orders.forEach(order => { %>
                        <% order.items.forEach(pro => { %>
                            <% let itemTotal = pro.price; %>
                            <% let discount = pro.couponDiscountAmt || 0; %>
                            <% let finalTotal = itemTotal - discount; %>
                            <% grandTotal += finalTotal; %>
                            <tr>
                                <td>#<%= order.orderId %></td>
                                <td><%= order.createdAt.toDateString() %></td>
                                <td><%= pro.product.productName %></td>
                                <td><%= pro.quantity %></td>
                                <td>₹<%= (pro.price / pro.quantity).toFixed(2) %></td>
                                <td>₹<%= itemTotal.toFixed(2) %></td>
                                <td>₹<%= discount.toFixed(2) %></td>
                            </tr>
                        <% }) %>
                    <% }) %>
                <% } %>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5"></td>
                    <td>₹<%= totalSalesAmount.toFixed(2) %></td>
                    <td>₹<%= totalDiscount.toFixed(2) %></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="pagination">
       
    </div>
</div>





