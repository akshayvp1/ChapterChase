<div class="card">
    <div class="card-datatable table-responsive">
        <div id="DataTables_Table_0_wrapper" class="dataTables_wrapper dt-bootstrap5 no-footer">
            <div class="card-header d-flex rounded-0 flex-wrap pb-md-0 pt-0">
                <div class="me-5 pe-5">
                  <div class="dataTables_filter">
                    <label>
                      <input type="search" id="search-coupon" class="form-control form-control-sm ms-0" 
                             placeholder="Search Coupon" aria-controls="DataTables_Table_0" value="<%= search %>">
                    </label>
                    <button class="btn btn-secondary add-new btn-primary waves-effect waves-light" 
                            onclick="searchCoupons()">Search</button>
                  </div>
                    
                </div>
                <div class="d-flex justify-content-start justify-content-md-end align-items-baseline">
                    <div class="dt-action-buttons d-flex align-items-start align-items-md-center justify-content-sm-center gap-4 pt-0">
                        <div class="dataTables_length my-0" id="DataTables_Table_0_length">
                        </div>
                        <div class="dt-buttons btn-group flex-wrap d-flex">
                            <div class="btn-group">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- views/admin/coupon-list.ejs -->
            <table class="datatables-coupons table dataTable no-footer dtr-column" id="DataTables_Table_0" aria-describedby="DataTables_Table_0_info">
                <thead>
                    <tr>
                        <th class="sorting_disabled dt-checkboxes-cell dt-checkboxes-select-all" rowspan="1" colspan="1" style="width: 18px;">
                            <!-- <input type="checkbox" class="form-check-input"> -->
                        </th>
                        <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 150px;" aria-label="Coupon Code: activate to sort column ascending">Coupon Code</th>
                        <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 200px;" aria-label="Description: activate to sort column ascending">Description</th>
                        <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 150px;" aria-label="Minimum Amount: activate to sort column ascending">Minimum Amount</th>
                        <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 150px;" aria-label="Redeem Amount: activate to sort column ascending">Redeem Amount</th>
                        <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 150px;" aria-label="Expiry Date: activate to sort column ascending">Expiry Date</th>
                        <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 100px;" aria-label="Status: activate to sort column ascending">Status</th>
                        <th class="text-nowrap sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 100px;" aria-label="Actions">Actions</th>
                    </tr>
                </thead>
                <tbody id="coupon-table-body">
                  <% coupons.forEach(coupon => { %>
                      <tr>
                          <td class="dt-checkboxes-cell">
                              <input type="checkbox" class="dt-checkboxes form-check-input">
                          </td>
                          <td><%= coupon.couponCode %></td>
                          <td><%= coupon.description %></td>
                          <td><%= coupon.minAmount %></td>
                          <td><%= coupon.redeemAmount %></td>
                          <td><%= new Date(coupon.expiryDate).toLocaleDateString() %></td>
                          <td><%= coupon.isListed ? 'Active' : 'Inactive' %></td>
                          <td>
                            <div class="d-inline-block">
                                <button onclick="openEditModal('<%= coupon._id %>')" class="btn btn-sm btn-icon edit-record">
                                    <i class="ri-pencil-line"></i>
                                </button>
                            </div>
                        </td>
                      </tr>
                      
                  <% }); %>
                  

              </tbody>
             
            </table>
            <div class="dataTables_paginate paging_simple_numbers justify-content-center mt-4" id="DataTables_Table_0_paginate">
              <ul class="pagination justify-content-center">
                <% if (currentPage > 1) { %>
                <li class="paginate_button page-item previous" id="DataTables_Table_0_previous">
                  <a href="/admin/coupon-list?page=<%= currentPage - 1 %>&limit=<%= limit %>&search=<%= search %>" class="page-link">Previous</a>
                </li>
                <% } %>
            
                <% let startPage = Math.max(1, currentPage - 2); %>
                <% let endPage = Math.min(totalPages, currentPage + 2); %>
            
                <% for (let i = startPage; i <= endPage; i++) { %>
                <li class="paginate_button page-item <%= i === currentPage ? 'active' : '' %>">
                  <a href="/admin/coupon-list?page=<%= i %>&limit=<%= limit %>&search=<%= search %>" class="page-link"><%= i %></a>
                </li>
                <% } %>
            
                <% if (currentPage < totalPages) { %>
                <li class="paginate_button page-item next" id="DataTables_Table_0_next">
                  <a href="/admin/coupon-list?page=<%= currentPage + 1 %>&limit=<%= limit %>&search=<%= search %>" class="page-link">Next</a>
                </li>
                <% } %>
              </ul>
            </div>
        </div>
        
    </div>



    <!-- Edit Coupon Modal -->
<div class="modal fade" id="editCouponModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
          <div class="modal-header">
              <h5 class="modal-title">Edit Coupon</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
              <form id="editCouponForm">
                  <input type="hidden" id="editCouponId">
                  <div class="mb-3">
                      <label for="editCouponCode" class="form-label">Coupon Code</label>
                      <input type="text" class="form-control" id="editCouponCode" required>
                  </div>
                  <div class="mb-3">
                      <label for="editDescription" class="form-label">Description</label>
                      <input type="text" class="form-control" id="editDescription" required>
                  </div>
                  <div class="mb-3">
                      <label for="editMinAmount" class="form-label">Minimum Amount</label>
                      <input type="number" class="form-control" id="editMinAmount" required>
                  </div>
                  <div class="mb-3">
                      <label for="editRedeemAmount" class="form-label">Redeem Amount</label>
                      <input type="number" class="form-control" id="editRedeemAmount" required>
                  </div>
                  <div class="mb-3">
                      <label for="editExpiryDate" class="form-label">Expiry Date</label>
                      <input type="date" class="form-control" id="editExpiryDate" required>
                  </div>
                  <div class="mb-3">
                      <label for="editStatus" class="form-label">Status</label>
                      <select class="form-select" id="editStatus" required>
                          <option value="true">Active</option>
                          <option value="false">Inactive</option>
                      </select>
                  </div>
              </form>
          </div>
          <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="button" class="btn btn-primary" onclick="updateCoupon()">Save changes</button>
          </div>
      </div>
  </div>
</div>



