<style>
/*  */
body {
  background-color: #f5f5f5;
  font-family: 'Poppins', sans-serif;
}

.text-dark {
  color: #343a40;
}

/* Card Styles */
.card {
  border-radius: 10px;
  border: 1px solid #e0e0e0;
}

.card-header {
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
}

.card-title {
  font-weight: 600;
  font-size: 1.25rem;
}

.card-body {
  padding: 2rem;
}

/* Form Group Styles */
.form-group {
  margin-bottom: 1.5rem;
}

.form-label {
  font-weight: 500;
  color: #495057;
}

/* Input and Select Styles */
.form-control,
.form-select {
  border-radius: 5px;
  border: 1px solid #ced4da;
  padding: 0.75rem 1rem;
  font-size: 1rem;
}

.form-control:focus,
.form-select:focus {
  border-color: #80bdff;
  outline: 0;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

/* Button Styles */
.btn-primary {
  background-color: #007bff;
  border-color: #007bff;
  transition: background-color 0.3s ease, border-color 0.3s ease;
}

.btn-primary:hover {
  background-color: #0056b3;
  border-color: #004085;
}

.btn-lg {
  font-size: 1rem;
  padding: 0.75rem 1.5rem;
}

/* Card and Button Shadows */
.shadow-sm {
  box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
}

.rounded-custom {
  border-radius: 12px;
}

.border-light {
  border-color: #e9ecef;
}

/* Custom Hover Effects */
.form-control:hover,
.form-select:hover {
  border-color: #adb5bd;
}

.form-control:focus:hover,
.form-select:focus:hover {
  border-color: #80bdff;
}




/*  */


  body {
    font-family: Arial, sans-serif;
    background-color: #f4f7f8;
    margin: 0;
    padding: 0;
}

.content-wrapper {
    padding: 20px;
}

.card {
    border-radius: 10px;
    overflow: hidden;
}

.card-header {
    background-color: #007bff;
    color: #fff;
}

.card-title {
    margin: 0;
}

.card-body {
    background-color: #fff;
}

.row {
    margin-bottom: 1rem;
}

.col-md-6 {
    padding: 0 1rem;
}

.form-control, .form-select {
    border-radius: 5px;
}

.btn-primary {
    background-color: #007bff;
    border: none;
    border-radius: 5px;
    color: #fff;
    padding: 10px 20px;
    cursor: pointer;
}

.btn-primary:hover {
    background-color: #0056b3;
}



.error-message {
    font-size: 0.875em;
    margin-top: 0.25rem;
}


</style>




