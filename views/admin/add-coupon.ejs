        <div class="d-flex flex-column flex-md-row justify-content-center align-items-center mb-5 gap-3">
          <h2 class="text-dark">Add a New Coupon</h2>
        </div>
  
        <div class="container py-4">
          <form id="addCouponForm">
            <!-- Coupon Information -->
            <div class="card shadow-sm mb-5 rounded-custom border-light">
              <div class="card-header py-3 bg-primary text-white">
                <h5 class="card-title mb-0">Coupon Information</h5>
              </div>
              <div class="card-body">
                <!-- Coupon Code and Description -->
                <div class="row mb-4">
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="couponCode" class="form-label">Coupon Code</label>
                      <input type="text" class="form-control" id="couponCode" name="couponCode" required placeholder="Enter coupon code">
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="description" class="form-label">Description</label>
                      <input type="text" class="form-control" id="description" name="description" required placeholder="Enter description">
                    </div>
                  </div>
                </div>
  
                <!-- Redeem Percentage and Minimum Amount -->
                <div class="row mb-4">
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="redeemAmount" class="form-label">Redeem Percentage (%)</label>
                      <input type="number" class="form-control" id="redeemAmount" name="redeemAmount" required placeholder="Enter redeem percentage">
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="minAmount" class="form-label">Minimum Amount</label>
                      <input type="number" class="form-control" id="minAmount" name="minAmount" required placeholder="Enter minimum amount">
                    </div>
                  </div>
                </div>
  
                <!-- Expiry Date and Status -->
                <div class="row mb-4">
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="expiryDate" class="form-label">Expiry Date</label>
                      <input type="date" class="form-control" id="expiryDate" name="expiryDate" required>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="publishStatus" class="form-label">Status</label>
                      <select class="form-select" id="publishStatus" name="publishStatus" required>
                          <option value="" selected>Select status</option>
                          <option value="Active">Active</option>
                          <option value="Inactive">Inactive</option>
                      </select>
                  </div>
                  </div>
                </div>
  
                <!-- Submit Button -->
                <div class="d-flex justify-content-end">
                  <button type="submit" class="btn btn-primary btn-lg px-5">Add Coupon</button>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  
  
  


 
