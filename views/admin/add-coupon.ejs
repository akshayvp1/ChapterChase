   <script>


document.getElementById('addCouponForm').addEventListener('submit', async function(event) {
    event.preventDefault();

    let isValid = true;

    // Clear previous error messages
    clearErrorMessages();

    // Coupon Code validation
    const couponCode = document.getElementById('couponCode');
    if (couponCode.value.trim().length !== 6) {
        showError(couponCode, 'Coupon code must be exactly 6 characters');
        isValid = false;
    }

    // Description validation (check for only spaces)
    const description = document.getElementById('description');
    if (description.value.trim().length === 0) {
        showError(description, 'Description cannot be empty or contain only spaces');
        isValid = false;
    }

    // Redeem Amount validation (as percentage)
    const redeemAmount = document.getElementById('redeemAmount');
    const redeemValue = redeemAmount.value.trim();
    if (isNaN(redeemValue) || redeemValue < 1 || redeemValue > 100) {
        showError(redeemAmount, 'The redeem amount must be a valid percentage between 1 and 100');
        isValid = false;
    }

    // Minimum Amount validation
    const minAmount = document.getElementById('minAmount');
    if (isNaN(minAmount.value.trim()) || minAmount.value.trim().length < 1) {
        showError(minAmount, "Give proper input for minimum amount");
        isValid = false;
    }

    // Expiry Date validation (must be a future date)
    const expiryDate = document.getElementById('expiryDate');
    const selectedDate = new Date(expiryDate.value);
    const currentDate = new Date();
    currentDate.setHours(0, 0, 0, 0); // Ignore time for comparison

    if (!expiryDate.value || selectedDate < currentDate) {
        showError(expiryDate, "Please select a valid expiry date");
        isValid = false;
    }

    if (!isValid) {
        return;
    }

    // // Convert status to boolean
    // const publishStatus = document.getElementById('publishStatus').value;
    // const isListed = publishStatus === "Active";

    // If all validations pass, proceed with form submission
    const formData = new FormData(this);
    const data = Object.fromEntries(formData.entries());

    // Log form data to check if publishStatus is included
    console.log('Form Data:', data);

    try {
        const response = await fetch('/admin/add-coupon', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        if (result.success) {
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: result.message,
                showConfirmButton: true
            }).then(() => {
                window.location.href = '/admin/add-coupon';
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: result.message,
            });
        }
    } catch (error) {
        console.error('Error:', error);
        Swal.fire({
            icon: 'error',
            title: 'Error!',
            text: 'An unexpected error occurred. Please try again.',
        });
    }
});



function showError(input, message) {
    const formControl = input.closest('.mb-3');
    let errorDisplay = formControl.querySelector('.error-message');
    
    if (!errorDisplay) {
        errorDisplay = document.createElement('div');
        errorDisplay.className = 'error-message text-danger';
        formControl.appendChild(errorDisplay);
    }
    
    errorDisplay.textContent = message;
    input.classList.add('is-invalid');
}

function clearErrorMessages() {
    document.querySelectorAll('.error-message').forEach(element => {
        element.remove();
    });
    document.querySelectorAll('.is-invalid').forEach(element => {
        element.classList.remove('is-invalid');
    });
}

// Restrict past dates in expiry date input
const expiryDateInput = document.getElementById('expiryDate');
const today = new Date().toISOString().split('T')[0];
expiryDateInput.setAttribute('min', today);

   </script>
