<div class="card">
    <div class="card-datatable table-responsive">
        <div id="DataTables_Table_0_wrapper" class="dataTables_wrapper dt-bootstrap5 no-footer">
            <div class="card-header d-flex rounded-0 flex-wrap pb-md-0 pt-0">
                <div class="me-5 pe-5">
                    <div id="DataTables_Table_0_filter" class="dataTables_filter">
                        <label>
                            <input type="search" id="search-coupon" class="form-control form-control-sm ms-0" 
                                   placeholder="Search Coupon" aria-controls="DataTables_Table_0">
                        </label>
                        <button class="btn btn-secondary add-new btn-primary waves-effect waves-light" tabindex="0" aria-controls="DataTables_Table_0" type="button" style="margin-left: 1150px;" onclick="location.href='/admin/add-product'">
                            <span><i class="ri-add-line ri-16px me-0 me-sm-2 align-baseline"></i>
                            <span class="d-none d-sm-inline-block">Add Product</span></span>
                          </button>
                          
                    </div>
                    
                </div>
                <div class="d-flex justify-content-start justify-content-md-end align-items-baseline">
                    <div class="dt-action-buttons d-flex align-items-start align-items-md-center justify-content-sm-center gap-4 pt-0">
                        <div class="dataTables_length my-0" id="DataTables_Table_0_length">
                        </div>
                        <div class="dt-buttons btn-group flex-wrap d-flex">
                            <div class="btn-group">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- views/admin/coupon-list.ejs -->
            <table class="datatables-coupons table dataTable no-footer dtr-column" id="DataTables_Table_0" aria-describedby="DataTables_Table_0_info">
                <thead>
                    <tr>
                       
                        <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 150px;" aria-label="Offer Name: activate to sort column ascending">Offer Name</th>
                        <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 150px;" aria-label="Offer Type: activate to sort column ascending">Offer Type</th>
                        <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 150px;" aria-label="Discount (%): activate to sort column ascending">Discount (%)</th>
                        <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 250px;" aria-label="Details: activate to sort column ascending">Details</th>
                        <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 100px;" aria-label="Status: activate to sort column ascending">Status</th>
                        <th class="text-nowrap sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" style="width: 100px;" aria-label="Actions">Actions</th>
                    </tr>
                </thead>
                
                <tbody id="coupon-table-body">
                  <% offers.forEach(offer => { %>
                      <tr>
                          <td><%= offer.offerName %></td>
                          <td><%= offer.offerType %></td>
                          <td><%= offer.discount %></td>
              
                          <!-- Check if offer is of type 'product' and display associated products -->
                          <td>
                              <% if (offer.offerType === 'product' && offer.productId && offer.productId.length > 0) { %>
                                  <%= offer.productId.map(product => product.productName).join(', ') %>
                              <% } else if (offer.offerType === 'category' && offer.categoryId && offer.categoryId.length > 0) { %>
                                  <%= offer.categoryId.map(category => category.title).join(', ') %>
                              <% } else { %>
                                  No associated products or categories
                              <% } %>
                          </td>
              
                          <td><%= offer.status %></td>
                          <td>
                              <button class="btn btn-sm btn-icon btn-text-secondary waves-effect waves-light rounded-pill edit-offer-button" 
                              data-offer-id="<%= offer._id %>">
                                  <i class="ri-edit-box-line ri-20px"></i>
                              </button>
                          </td>
                      </tr>
                  <% }) %>
              </tbody>
              
              
              
            </table>
        </div>
    </div>




    <!-- Edit Offer Modal -->
    <div class="modal fade" id="editOfferModal" tabindex="-1" aria-labelledby="editOfferModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg">
          <div class="modal-content">
              <div class="modal-header">
                  <h5 class="modal-title" id="editOfferModalLabel">Edit Offer</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <form id="editOfferForm" method="post">
                  <div class="modal-body">
                      <!-- Offer Information -->
                      <div class="row">
                          <div class="col-md-6">
                              <div class="mb-3">
                                  <label for="offerTypeEdit" class="form-label">Offer Type:</label>
                                  <select class="form-select" id="offerTypeEdit" name="offerType" required>
                                      <option value="" disabled>Select Offer Type</option>
                                      <option value="product">Product Offer</option>
                                      <option value="category">Category Offer</option>
                                  </select>
                              </div>
                          </div>
                          <div class="col-md-6">
                              <div class="mb-3">
                                  <label for="offerNameEdit" class="form-label">Offer Name:</label>
                                  <input type="text" class="form-control" id="offerNameEdit" name="offerName" required>
                              </div>
                          </div>
                      </div>
                      <!-- Discount and Status -->
                      <div class="row">
                          <div class="col-md-6">
                              <div class="mb-3">
                                  <label for="discountEdit" class="form-label">Discount (%):</label>
                                  <input type="number" class="form-control" id="discountEdit" name="discount" required>
                              </div>
                          </div>
                          <div class="col-md-6">
                              <div class="mb-3">
                                  <label for="statusEdit" class="form-label">Status:</label>
                                  <select class="form-select" id="statusEdit" name="status" required>
                                      <option value="active">Active</option>
                                      <option value="inactive">Inactive</option>
                                  </select>
                              </div>
                          </div>
                      </div>
                      <!-- Category and Product -->
                      <div class="row">
                          <div class="col-md-6">
                              <div class="mb-3" id="categoryGroup">
                                  <label for="categoryEdit" class="form-label">Category:</label>
                                  <select class="form-select select2-multiple" id="categoryEdit" name="categoryId" multiple>
                                      <!-- Options will be added dynamically -->
                                  </select>
                              </div>
                          </div>
                          <div class="col-md-6">
                              <div class="mb-3" id="productGroup">
                                  <label for="productEdit" class="form-label">Product:</label>
                                  <select class="form-select select2-multiple" id="productEdit" name="productId" multiple>
                                      <!-- Options will be added dynamically -->
                                  </select>
                              </div>
                          </div>
                      </div>
                  </div>
                  <div class="modal-footer">
                      <button type="submit" class="btn btn-primary">Save Changes</button>
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                  </div>
              </form>
          </div>
      </div>
    </div>
    







  
  
  





