   <script>
$(document).ready(function() {
    // Initialize Select2
    $('.select2-multiple').select2({
        placeholder: "Select options",
        allowClear: true,
        tags: true,
        tokenSeparators: [',', ' '],
        maximumSelectionLength: 10  // Optional: limit the number of selections
    });
  })




$(document).ready(function() {
    // Attach click event to all edit buttons
    $('.edit-offer-button').on('click', function() {
        // Get the offer ID from the data attribute of the clicked button
        const offerId = $(this).data('offer-id');

        // Make an AJAX request to fetch the offer data
        $.ajax({
    url: `/admin/get-offer/${offerId}`, // Ensure this URL is correct
    type: 'GET',
    success: function(response) {
        if (response.success) {
            const offer = response.offer;

            // Populate the modal with the fetched data
            $('#editOfferModal #offerName').val(offer.offerName);
            $('#editOfferModal #offerType').val(offer.offerType);
            $('#editOfferModal #discount').val(offer.discount);
            $('#editOfferModal #status').val(offer.status);

            // Handle the selection for product or category based on offerType
            if (offer.offerType === 'product') {
                $('#productSelect').show();
                $('#categorySelect').hide();

                // Empty and populate the product select dropdown
                $('#editOfferModal #productSelect').empty();
                offer.productId.forEach(product => {
                    $('#editOfferModal #productSelect').append(
                        `<option value="${product._id}" selected>${product.productName}</option>`
                    );
                });

            } else if (offer.offerType === 'category') {
                $('#categorySelect').show();
                $('#productSelect').hide();

                // Empty and populate the category select dropdown
                $('#editOfferModal #categorySelect').empty();
                offer.categoryId.forEach(category => {
                    $('#editOfferModal #categorySelect').append(
                        `<option value="${category._id}" selected>${category.title}</option>`
                    );
                });
            }

            // Show the modal
            $('#editOfferModal').modal('show');
        } else {
            alert('Failed to load offer data');
        }
    },
    error: function(err) {
        console.error('Error fetching offer data:', err); // Log detailed error information
        alert('An error occurred while fetching offer data. Please try again.');
    }
});


    });

    // Handle form submission for saving changes
    $('#editOfferForm').on('submit', function(e) {
        e.preventDefault(); // Prevent the form from submitting the traditional way

        // Get the offer ID from a hidden input or another source
        const offerId = $('#editOfferModal').data('offer-id');

        // Serialize the form data
        const formData = $(this).serialize();

        // Make an AJAX request to update the offer
        $.ajax({
            url: `/update-offer/${offerId}`, // Adjust the URL based on your route structure
            type: 'PATCH',
            data: formData,
            success: function(response) {
                if (response.success) {
                    alert('Offer updated successfully');
                    // Optionally, reload the page or update the UI to reflect changes
                    location.reload();
                } else {
                    alert('Failed to update offer');
                }
            },
            error: function(err) {
                console.error('Error updating offer:', err);
                alert('An error occurred while updating the offer. Please try again.');
            }
        });
    });
});









function searchOffers() {
  const searchTerm = document.getElementById('search-offer').value;
  window.location.href = `/admin/offer-list?page=1&limit=<%= limit %>&search=${searchTerm}`;
}


   </script>


   
