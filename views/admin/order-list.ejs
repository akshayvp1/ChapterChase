  <script>
// Global variable to store the current order ID


let currentOrderId;

function showAlert(message, icon = 'info') {
  return Swal.fire({
    text: message,
    icon: icon,
    confirmButtonText: 'OK',
    customClass: {
      container: 'my-swal'
    }
  });
}

async function showConfirm(message) {
  const result = await Swal.fire({
    text: message,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Yes',
    cancelButtonText: 'No',
    customClass: {
      container: 'my-swal'
    }
  });
  return result.isConfirmed;
}

async function openOrderDetailsModal(orderId) {
  currentOrderId = orderId;
  try {
    const response = await fetch(`/admin/order/${orderId}`);
    const order = await response.json();

    if (response.ok) {
      // Populate the modal with order details
      document.querySelector('.order-id').textContent = order.orderId;
      document.querySelector('.order-date').textContent = new Date(order.createdAt).toLocaleDateString();
      document.querySelector('.total-amount').textContent = order.totalPrice.toFixed(2);
      document.querySelector('.order-status').textContent = order.items[0].order_status;
      document.querySelector('.payment-type').textContent = order.paymentMethod;
      document.querySelector('.payment-status').textContent = order.payment_status;
      document.querySelector('.name').textContent = order.address.addressName;
      document.querySelector('.street').textContent = `${order.address.addressHouse}, ${order.address.addressStreet}`;
      document.querySelector('.city').textContent = order.address.addressCity;
      document.querySelector('.zip').textContent = order.address.addressPin;
      document.querySelector('.state').textContent = order.address.addressState;
      document.querySelector('.phone').textContent = order.address.addressMobile;

      // Populate the order items table
      const orderItemsTable = document.querySelector('.order-items-table');
      orderItemsTable.innerHTML = '';
      order.items.forEach(item => {
        const row = document.createElement('tr');
        row.innerHTML = `
          <td>${item.product.productName}</td>
          <td>${item.quantity}</td>
          <td>₹${item.price/item.quantity}</td>
          <td>₹${ item.price}</td>
        `;
        orderItemsTable.appendChild(row);
      });

      // Show the modal
      document.querySelector('#orderDetailsModal').style.display = 'block';
    } else {
      await showAlert('Failed to fetch order details.', 'error');
    }
  } catch (error) {
    console.error('Error:', error);
    await showAlert('Error fetching order details.', 'error');
  }
}

async function updateOrderStatus(orderId, itemId, newStatus) {
  try {
    const response = await fetch(`/admin/order/${orderId}/status`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ itemId, status: newStatus }),
    });

    if (response.ok) {
      await showAlert('Order status updated successfully', 'success');
      // Refresh the order list
      location.reload();
    } else {
      await showAlert('Failed to update order status', 'error');
    }
  } catch (error) {
    console.error('Error:', error);
    await showAlert('Error updating order status', 'error');
  }
}

async function confirmReturn(orderId, itemId) {
  try {
    const response = await fetch('/admin/confirm-return', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ orderId, itemId }),
    });

    if (response.ok) {
      await showAlert('Return confirmed successfully', 'success');
      location.reload();
    } else {
      await showAlert('Failed to confirm return', 'error');
    }
  } catch (error) {
    console.error('Error:', error);
    await showAlert('Error confirming return', 'error');
  }
}

// Event listeners
document.addEventListener('DOMContentLoaded', function() {
  // View button event listener
  document.querySelectorAll('.view-btn').forEach(button => {
    button.addEventListener('click', function() {
      const orderId = this.getAttribute('data-order-id');
      openOrderDetailsModal(orderId);
    });
  });

  // Status change event listener
  document.querySelectorAll('.status-select').forEach(select => {
    select.addEventListener('change', async function() {
      const orderId = this.getAttribute('data-order-id');
      const itemId = this.getAttribute('data-item-id');
      const newStatus = this.value;
      const currentStatus = this.options[this.selectedIndex].text;

      if (['Cancelled', 'Returned', 'Return Requested'].includes(currentStatus)) {
        this.value = currentStatus;
        await showAlert('This order status cannot be changed.', 'info');
        return;
      }

      if (currentStatus === 'Delivered' && newStatus !== 'Delivered') {
        this.value = 'Delivered';
        await showAlert('Delivered orders cannot be changed to a different status.', 'info');
        return;
      }

      if (currentStatus === 'Processing' && newStatus === 'Pending') {
        this.value = currentStatus;
        await showAlert('Processing orders cannot be changed back to Pending.', 'info');
        return;
      }

      const confirmed = await showConfirm(`Are you sure you want to change the status to ${newStatus}?`);
      if (confirmed) {
        await updateOrderStatus(orderId, itemId, newStatus);
      } else {
        this.value = currentStatus;
      }
    });
  });

  // Confirm return button event listener
  document.querySelectorAll('.confirm-return-btn').forEach(button => {
    button.addEventListener('click', async function() {
      const orderId = this.getAttribute('data-order-id');
      const itemId = this.getAttribute('data-item-id');
      
      const confirmed = await showConfirm('Are you sure you want to confirm this return?');
      if (confirmed) {
        await confirmReturn(orderId, itemId);
      }
    });
  });

  // Close the modal when clicking on the close button
  document.querySelectorAll('.close-btn').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelector('#orderDetailsModal').style.display = 'none';
    });
  });
});


  </script>
  
</body>


