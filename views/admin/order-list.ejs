<!-- Order List Table -->
<div class="card">
  <div class="card-datatable table-responsive">
    <div class="search-container">
      <form id="searchForm" method="get" action="/admin/order-details" class="search-form">
        <input type="text" name="search" placeholder="Search by Order ID " value="<%= search %>" class="search-input">
        <button type="submit" class="search-button">Search</button>
      </form>
    </div>

    <table class="datatables-order">
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Date</th>
          <th>Price</th>
          <th>Status</th>
          <th>Confirm Request</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders.length === 0) { %>
            <tr>
                <td colspan="6" class="no-orders">No orders found for this user.</td>
            </tr>
        <% } else { %>
            <% orders.forEach(order => { %>
                <% order.items.forEach(pro => { %>
                    <tr>
                        <td>#<%= order.orderId %></td>
                        <td><%= new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' }) %></td>
                        <td>₹<%= pro.price.toFixed(2) %></td>
                        <td>
                            <% if (pro.order_status === 'Retry') { %>
                                <select class="status-select" data-order-id="<%= order._id %>" data-item-id="<%= pro._id %>">
                                    <option value="Retry" selected>Retry</option>
                                </select>
                            <% } else { %>
                                <select class="status-select" data-order-id="<%= order._id %>" data-item-id="<%= pro._id %>">
                                    <% if (pro.order_status === 'Pending') { %>
                                        <option value="Pending" selected>Pending</option>
                                        <option value="Processing">Processing</option>
                                        <option value="Shipped">Shipped</option>
                                        <option value="Delivered">Delivered</option>
                                    <% } else if (pro.order_status === 'Processing') { %>
                                        <option value="Processing" selected>Processing</option>
                                        <option value="Shipped">Shipped</option>
                                        <option value="Delivered">Delivered</option>
                                    <% } else if (pro.order_status === 'Shipped') { %>
                                        <option value="Shipped" selected>Shipped</option>
                                        <option value="Delivered">Delivered</option>
                                    <% } else if (pro.order_status === 'Delivered') { %>
                                        <option value="Delivered" selected>Delivered</option>
                                    <% } else if (['Cancelled', 'Returned', 'Return Requested'].includes(pro.order_status)) { %>
                                        <option value="<%= pro.order_status %>" selected><%= pro.order_status %></option>
                                    <% } %>
                                </select>
                            <% } %>
                        </td>
                        <td>
                            <% if (pro.order_status === 'Return Requested') { %>
                                <button class="confirm-return-btn" data-order-id="<%= order._id %>" data-item-id="<%= pro._id %>">Confirm Return</button>
                            <% } else { %>
                                <span class="no-request">No Request</span>
                            <% } %>
                        </td>
                        <td>
                            <button class="view-btn" data-order-id="<%= order._id %>">View</button>
                        </td>
                    </tr>
                <% }) %>
            <% }) %>
        <% } %>
    </tbody>
    </table>

    <div class="pagination">
      <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="/admin/order-details?page=<%= i %>&limit=<%= limit %>&search=<%= search %>" class="pagination-link <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
      <% } %>
    </div>
  </div>
</div>















</div>
