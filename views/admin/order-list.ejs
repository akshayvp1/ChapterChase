/* //// */
/* Table Styles */
.datatables-order {
  width: 100%;
  border-collapse: collapse;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  color: #333;
  background-color: #f8f9fa; /* Light gray background */
}

.datatables-order th,
.datatables-order td {
  padding: 15px;
  text-align: left;
  border-bottom: 1px solid #dee2e6;
}

.datatables-order thead {
  background-color: #343a40; /* Dark gray header */
  color: #fff;
  font-weight: bold;
}

.datatables-order tbody tr:nth-of-type(even) {
  background-color: #e9ecef; /* Alternating row color */
}

.datatables-order th {
  font-weight: 600;
  text-transform: uppercase;
  text-align: center;
}

/* Status Select Styles */
.datatables-order .status-select {
  padding: 5px 10px;
  border-radius: 4px;
  border: 1px solid #ccc;
  background-color: #f1f1f1;
  color: #495057;
  cursor: pointer;
  transition: background-color 0.3s ease, border-color 0.3s ease;
}

.datatables-order .status-select:hover {
  background-color: #e2e6ea; /* Slight hover effect */
  border-color: #6c757d;
}

.datatables-order .status-select option[value="Pending"] {
  background-color: #ffc107;
  color: #212529;
}

.datatables-order .status-select option[value="Processing"] {
  background-color: #17a2b8;
  color: #fff;
}

.datatables-order .status-select option[value="Shipped"] {
  background-color: #007bff;
  color: #fff;
}

.datatables-order .status-select option[value="Delivered"] {
  background-color: #28a745;
  color: #fff;
}

.datatables-order .status-select option[value="Cancelled"],
.datatables-order .status-select option[value="Returned"],
.datatables-order .status-select option[value="Return Requested"] {
  background-color: #dc3545;
  color: #fff;
}

/* Button Styles */
.view-btn,
.confirm-return-btn {
  display: inline-block;
  padding: 8px 12px;
  color: #fff;
  text-decoration: none;
  border-radius: 4px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.3s ease;
  margin-right: 5px;
}

.view-btn {
  background-color: #6c757d;
}

.confirm-return-btn {
  background-color: #dc3545;
}

.view-btn:hover {
  background-color: #5a6268;
}

.confirm-return-btn:hover {
  background-color: #c82333;
}

/* No Orders and No Request Styles */
.no-orders {
  text-align: center;
  font-style: italic;
  color: #888;
}

.no-request {
  color: #999;
  font-style: italic;
}

/* Center Alignment for Table Content */
.datatables-order th,
.datatables-order td {
  text-align: center;
}



