  <!-- Modal -->
<div class="modal fade" id="addressModal" tabindex="-1" aria-labelledby="addressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg"> <!-- Increased modal size -->
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addressModalLabel">Add Address</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="addressForm" action="/add-address" method="POST">
            <input type="hidden" id="addressId" name="addressId">

            <div class="row g-3">
              <div class="col-md-6">
                <label for="addressName" class="form-label">Name</label>
                <input type="text" id="addressName" name="addressName" class="form-control" placeholder="Name" required>
              </div>
              <div class="col-md-6">
                <label for="addressEmail" class="form-label">Email</label>
                <input type="email" id="addressEmail" name="addressEmail" class="form-control" placeholder="Email" required>
              </div>
              <div class="col-md-6">
                <label for="addressMobile" class="form-label">Mobile</label>
                <input type="tel" id="addressMobile" name="addressMobile" class="form-control" placeholder="Mobile" required>
              </div>
              <div class="col-md-6">
                <label for="addressHouse" class="form-label">House Number</label>
                <input type="text" id="addressHouse" name="addressHouse" class="form-control" placeholder="House Number" required>
              </div>
              <div class="col-md-6">
                <label for="addressStreet" class="form-label">Street</label>
                <input type="text" id="addressStreet" name="addressStreet" class="form-control" placeholder="Street" required>
              </div>
              <div class="col-md-6">
                <label for="addressPost" class="form-label">Post</label>
                <input type="text" id="addressPost" name="addressPost" class="form-control" placeholder="Post" required>
              </div>
              <div class="col-md-6">
                <label for="addressCity" class="form-label">City</label>
                <input type="text" id="addressCity" name="addressCity" class="form-control" placeholder="City" required>
              </div>
              <div class="col-md-6">
                <label for="addressDistrict" class="form-label">District</label>
                <input type="text" id="addressDistrict" name="addressDistrict" class="form-control" placeholder="District" required>
              </div>
              <div class="col-md-6">
                <label for="addressState" class="form-label">State</label>
                <input type="text" id="addressState" name="addressState" class="form-control" placeholder="State" required>
              </div>
              <div class="col-md-6">
                <label for="addressPin" class="form-label">Pin</label>
                <input type="number" id="addressPin" name="addressPin" class="form-control" placeholder="Pin" required>
              </div>
            </div>
            <div class="text-center mt-3">
              <button type="submit" id="saveAddress" class="btn btn-primary">Save Address</button>
            </div>
        </div>
          </form>
        </div>
      </div>
    </div>
