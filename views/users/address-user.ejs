<link href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<script>
    
    document.addEventListener('DOMContentLoaded', function() {
    const addressForm = document.getElementById('addressForm');
    
    if (addressForm) {
        addressForm.addEventListener('submit', function(event) {
            event.preventDefault();
            console.log('Form submitted');

            var formData = new FormData(this);
            var plainFormData = Object.fromEntries(formData.entries());
            
            // Convert pin to number
            plainFormData.addressPin = parseInt(plainFormData.addressPin, 10);

            console.log('Form data:', plainFormData);

            fetch('/add-address', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(plainFormData),
            })
            .then(response => response.json())
            .then(data => {
                console.log('Response data:', data);
                if (data.error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: data.error,
                    });
                } else {
                    console.log('Address saved successfully');
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: 'Address saved successfully!',
                    });
                    
                    // Add the new address to the list
                    addAddressToList(data.address);
                    
                    // Close the modal
                    $('#addressModal').modal('hide');
                    
                    // Reset the form
                    addressForm.reset();
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'An error occurred while saving the address. Please try again.',
                });
            });
        });
    } else {
        console.error('Address form not found');
    }

    function addAddressToList(address) {
        const addressList = document.getElementById('addressList');
        const newAddressHtml = `
            <div class="col-lg-6">
                <div class="card card-dashboard">
                    <div class="card-body">
                        <h3 class="card-title">${address.addressName}</h3>
                        <p>
                            ${address.addressHouse}<br>
                            ${address.addressStreet}<br>
                            ${address.addressPost}, ${address.addressCity}<br>
                            ${address.addressState}<br>
                            Pin: ${address.addressPin}<br>
                            ${address.addressEmail}<br>
                            Mobile: ${address.addressMobile}<br>
                        </p>
                        <div class="actions">
                            <a href="#" class="edit">Edit <i class="icon-edit"></i></a>
                            <a href="#" class="delete">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        `;
        addressList.insertAdjacentHTML('beforeend', newAddressHtml);
    }
});



document.addEventListener('DOMContentLoaded', () => {
  // Event listener for edit buttons
  document.querySelectorAll('.edit').forEach(button => {
    button.addEventListener('click', async (event) => {
      event.preventDefault();
      const addressId = button.getAttribute('data-id');
      try {
        const response = await fetch(`/get-address/${addressId}`);
        if (response.ok) {
          const address = await response.json();
          console.log('Fetched address:', address); // Add this line
          populateEditModal(address);
        } else {
          console.error('Failed to fetch address details');
        }
      } catch (error) {
        console.error('Error fetching address details:', error);
      }
    });
  });

  function populateEditModal(address) {
    document.getElementById('editAddressId').value = address._id;
    document.getElementById('editAddressName').value = address.addressName;
    document.getElementById('editAddressEmail').value = address.addressEmail;
    document.getElementById('editAddressMobile').value = address.addressMobile;
    document.getElementById('editAddressHouse').value = address.addressHouse;
    document.getElementById('editAddressStreet').value = address.addressStreet;
    document.getElementById('editAddressPost').value = address.addressPost;
    document.getElementById('editAddressCity').value = address.addressCity;
    document.getElementById('editAddressDistrict').value = address.addressDistrict;
    document.getElementById('editAddressState').value = address.addressState;
    document.getElementById('editAddressPin').value = address.addressPin;

    const editAddressModal = new bootstrap.Modal(document.getElementById('editAddressModal'));
    editAddressModal.show();
}

  // Event listener for edit form submission
  document.getElementById('editAddressForm').addEventListener('submit', async (event) => {
  event.preventDefault();
  
  const form = event.target;
  const formData = new FormData(form);
  const addressId = formData.get('addressId');
  
  try {
    const response = await fetch(`/edit-address/${addressId}`, {
      method: 'PATCH',
      body: JSON.stringify(Object.fromEntries(formData)),
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
      }
    });

    const result = await response.json();

    if (response.ok) {
      console.log('Update successful:', result);
      
      // Try to close the modal
      try {
        const editAddressModal = document.getElementById('editAddressModal');
        if (editAddressModal) {
          const bsModal = bootstrap.Modal.getInstance(editAddressModal);
          if (bsModal) {
            bsModal.hide();
          } else {
            editAddressModal.style.display = 'none';
            document.body.classList.remove('modal-open');
            const modalBackdrop = document.querySelector('.modal-backdrop');
            if (modalBackdrop) {
              modalBackdrop.remove();
            }
          }
        }
      } catch (modalError) {
        console.error('Error closing modal:', modalError);
      }

      // Update the address in the list
      updateAddressInList(result);
      
      Swal.fire({
        icon: 'success',
        title: 'Success!',
        text: 'Address updated successfully!',
      });

      // Reload the page after a short delay
      setTimeout(() => {
        window.location.reload();
      }, 1500);

    } else {
      throw new Error(result.message || 'Failed to update address');
    }
  } catch (error) {
    console.error('Error updating address:', error);
    Swal.fire({
      icon: 'error',
      title: 'Oops...',
      text: `An error occurred while updating the address: ${error.message}`,
    });
  }
});

function updateAddressInList(updatedAddress) {
  try {
    const addressList = document.getElementById('addressList');
    const addressCards = addressList.querySelectorAll('.card-dashboard');

    addressCards.forEach(card => {
      const editButton = card.querySelector('.edit');
      if (editButton && editButton.getAttribute('data-id') === updatedAddress._id) {
        card.querySelector('.card-title').textContent = updatedAddress.addressName;
        const addressParagraph = card.querySelector('p');
        if (addressParagraph) {
          addressParagraph.innerHTML = `
            ${updatedAddress.addressHouse || ''}<br>
            ${updatedAddress.addressStreet || ''}<br>
            ${updatedAddress.addressPost || ''}, ${updatedAddress.addressCity || ''}<br>
            ${updatedAddress.addressState || ''}<br>
            Pin: ${updatedAddress.addressPin || ''}<br>
            ${updatedAddress.addressEmail || ''}<br>
            Mobile: ${updatedAddress.addressMobile || ''}<br>
          `;
        }
      }
    });
  } catch (error) {
    console.error('Error updating address in list:', error);
  }
}
});



   // Attach event listeners to delete buttons
   document.querySelectorAll('.delete').forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const addressId = this.dataset.id; // Get address ID from data attribute
      
      // Show SweetAlert confirmation dialog
      Swal.fire({
        title: 'Are you sure?',
        text: "You won't be able to revert this!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, delete it!'
      }).then((result) => {
        if (result.isConfirmed) {
          // Send DELETE request to the server
          fetch(`/delete-address/${addressId}`, {
            method: 'DELETE'
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              Swal.fire(
                'Deleted!',
                'The address has been deleted.',
                'success'
              );
              // Optionally, remove the address from the UI
              this.closest('.col-lg-6').remove();
            } else {
              Swal.fire(
                'Error!',
                'There was an error deleting the address.',
                'error'
              );
            }
          })
          .catch(error => {
            Swal.fire(
              'Error!',
              'There was an error deleting the address.',
              'error'
            );
          });
        }
      });
    });
  });





  document.addEventListener('DOMContentLoaded', function () {
    // Function to validate form fields
    function validateForm() {
      const forms = document.querySelectorAll('.needs-validation');
      forms.forEach(form => {
        form.addEventListener('submit', function (event) {
          if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
            form.classList.add('was-validated');
          }
        }, false);
      });
    }
    validateForm();
  });


  document.addEventListener('DOMContentLoaded', function() {
    const logoutLink = document.querySelector('a[href="/logout"]');

    if (logoutLink) {
        logoutLink.addEventListener('click', function(event) {
            event.preventDefault(); // Prevent the default link behavior

            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to recover your session!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, sign out!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Redirect to the logout URL
                    window.location.href = '/logout';
                }
            });
        });
    }
});




</script>




