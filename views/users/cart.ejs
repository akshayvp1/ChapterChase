	                <div class="container">
	                	<div class="row">
	                		<div class="col-lg-9">
	                			<table class="table table-cart table-mobile">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th>Price</th>
                                            <th>Quantity</th>
                                            <th>Total</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    
                                       
                                    <tbody>

                                        <% if (cartItems.length === 0) { %>
                                            <tr>
                                                <td colspan="5" class="text-center">
                                                    <a href="products-list">
                                                        <img src="assets/images/empty-cart.png" alt="Your wishlist is empty" style="max-width: 150px; margin-left: 420px;">
                                                    </a>
                                                </td>
                                            </tr>
                                        <% } %>
                                        

                                        <% cartItems.forEach(item => { %>
                                        <tr data-product-id="<%= item.product._id %>">
                                            <td class="product-col">
                                                <div class="product">
                                                    <figure class="product-media">
                                                        <a href="/product-details/<%= item.product._id %>">
                                                            <img src="/assets/uploads/<%= item.product.images[0] %>" alt="Product image" class="product-image">
                                                        </a>
                                                    </figure>
                                                    <h3 class="product-title">
                                                        <a href="/product/<%= item.product._id %>"><%= item.product.productName %></a>
                                                    </h3>
                                                </div>
                                            </td>
                                    
                                            <!-- Price and Discount Logic -->
                                            <td class="price-col">
                                                <% 
                                                    let discountedPrice = item.product.price;
                                                    let bestDiscountPercentage = 0;
                                                    
                                                    // Find the best product-specific offer (if any)
                                                    const productOffers = offers.filter(o => 
                                                        o.offerType === 'product' && o.productId.includes(item.product._id.toString())
                                                    );
                                                    
                                                    // Check if there's any product-specific offer
                                                    if (productOffers.length > 0) {
                                                        // Find the product-specific offer with the highest discount
                                                        const bestProductOffer = productOffers.reduce((max, offer) => 
                                                            offer.discount > max.discount ? offer : max, productOffers[0]);
                                                        
                                                        bestDiscountPercentage = bestProductOffer.discount;
                                                        discountedPrice = item.product.price - (item.product.price * (bestDiscountPercentage / 100));
                                                    }
                                                    
                                                    // Now check all category offers and see if any offer a better discount
                                                    offers.forEach(offer => {
                                                        if (offer.offerType === 'category' && offer.categoryId.includes(item.product.category.toString())) {
                                                            const currentDiscountPercentage = offer.discount;
                                                            if (currentDiscountPercentage > bestDiscountPercentage) {
                                                                bestDiscountPercentage = currentDiscountPercentage;
                                                                discountedPrice = item.product.price - (item.product.price * (bestDiscountPercentage / 100));
                                                            }
                                                        }
                                                    });
                                                %>
                                                
                                                <% if (bestDiscountPercentage > 0) { %>
                                                    <span class="product-price-discounted">
                                                        ₹<%= discountedPrice.toFixed(2) %>
                                                    </span>
                                                    <p class="product-price-original">
                                                        ₹<%= item.product.price.toFixed(2) %>
                                                    </p>
                                                    <p class="product-price-discount">
                                                        <%= bestDiscountPercentage %>% Off
                                                    </p>
                                                <% } else { %>
                                                    ₹<%= item.product.price.toFixed(2) %>
                                                <% } %>
                                            </td>
                                            
                                    
                                            <td class="quantity-col">
                                                <div class="cart-product-quantity">
                                                    <input 
                                                        type="number" 
                                                        class="form-control" 
                                                        value="<%= item.quantity %>" 
                                                        min="1" 
                                                        max="10" 
                                                        step="1" 
                                                        required
                                                        data-product-id="<%= item.product._id %>" 
                                                        data-product-stock="<%= item.product.stock %>" 
                                                    />
                                                </div>
                                            </td>
                                            
                                            
                                            
                                    
                                            <td class="total-col">
                                                <% if (item.discountPercentage > 0) { %>
                                                    ₹<%= (item.total - (item.total * (item.discountPercentage / 100))).toFixed(2) %>
                                                <% } else { %>
                                                    ₹<%= item.total.toFixed(2) %>
                                                <% } %>
                                            </td>
                                    
                                            <td class="remove-col">
                                                <button class="btn-remove" data-product-id="<%= item.product._id %>"><i class="icon-close"></i></button>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    </tbody>
                                    
                                    
                                    
                                    </table>

	                			
	                		</div><!-- End .col-lg-9 -->
