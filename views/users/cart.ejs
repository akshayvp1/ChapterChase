    <script>
 document.addEventListener('DOMContentLoaded', function() {
    // Function to handle item removal with confirmation
    async function removeFromCart(productId) {
        try {
            // Show confirmation dialog
            const result = await Swal.fire({
                title: 'Are you sure?',
                text: 'Do you really want to remove this item from your cart?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, remove it!',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            });

            // If the user confirms, proceed with removal
            if (result.isConfirmed) {
                const response = await fetch('/remove-from-cart', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ productId })
                });

                const result = await response.json();
                if (response.ok) {
                    // Remove the item from the DOM
                    const row = document.querySelector(`tr[data-product-id="${productId}"]`);
                    if (row) {
                        row.remove();
                    }
                    Swal.fire(
                        'Removed!',
                        'The item has been removed from your cart.',
                        'success'
                    );
                    setTimeout(()=>{
                    window.location.reload();
                },2000)
                    updateTotals(); // Update totals after removal
                } else {
                    Swal.fire(
                        'Error!',
                        result.message || 'There was a problem removing the item.',
                        'error'
                    );
                }
            }
        } catch (error) {
            console.error('Error removing item from cart:', error);
            Swal.fire(
                'Error!',
                'An unexpected error occurred.',
                'error'
            );
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const quantityInputs = document.querySelectorAll('.form-control');
        const MAX_QUANTITY = 10;

        quantityInputs.forEach(input => {
            const productId = input.dataset.productId;
            const stock = parseInt(input.dataset.productStock, 10);

            // Set the initial state of the plus button
            var plusButton = input.closest('tr').querySelector('.btn-plus');
            if (parseInt(input.value, 10) >= stock) {
                plusButton.disabled = true;
            }

            input.addEventListener('input', async (event) => {
                let newQuantity = parseInt(event.target.value, 10);

                if (newQuantity > stock) {
                    event.target.value = stock;
                    newQuantity = stock;
                    Swal.fire({
                        icon: 'warning',
                        title: 'Stock Limit Exceeded',
                        text: `Only ${stock} product(s) left in stock.`,
                    });
                } else if (newQuantity > MAX_QUANTITY) {
                    event.target.value = MAX_QUANTITY;
                    newQuantity = MAX_QUANTITY;
                    Swal.fire({
                        icon: 'warning',
                        title: 'Quantity Limit Exceeded',
                        text: `You can add up to ${MAX_QUANTITY} product(s) only.`,
                    });
                }

                // Update the plus button state
                if (newQuantity >= stock) {
                    event.target.closest('tr').querySelector('.btn-plus').disabled = true;
                } else {
                    event.target.closest('tr').querySelector('.btn-plus').disabled = false;
                }

                // Update the cart with the new quantity
                await updateCart(productId, newQuantity);
            });

            // Handle click events for the plus and minus buttons
            const minusButton = input.closest('tr').querySelector('.btn-minus');
            var plusButton = input.closest('tr').querySelector('.btn-plus');

            minusButton.addEventListener('click', async () => {
                let currentQuantity = parseInt(input.value, 10);
                if (currentQuantity > 1) {
                    input.value = currentQuantity - 1;
                    await updateCart(productId, currentQuantity - 1);
                }
            });

            plusButton.addEventListener('click', async () => {
                let currentQuantity = parseInt(input.value, 10);
                if (currentQuantity < stock) {
                    input.value = currentQuantity + 1;
                    await updateCart(productId, currentQuantity + 1);
                }
            });
        });
    });

    async function updateCart(productId, quantity) {
        try {
            const response = await fetch('/update-cart', {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productId: productId,
                    quantity: quantity
                })
            });

            const data = await response.json();
            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Cart Updated',
                    text: 'The cart has been updated successfully.',
                });
               
            } else {
                Swal.fire({
                icon: 'error',
                title: 'Update Failed',
                text: data.message || 'An error occurred while updating the cart.',
            }).then(() => {
                // Set timeout to reload the page after 3 seconds
                setTimeout(() => {
                    window.location.reload();
                }, 2000); // 3000 milliseconds = 3 seconds
            });
        }
            
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'An unexpected error occurred.',
            });
        }
    }

    // Function to update totals and cart
    function updateTotals() {
        let subtotal = 0;
        const cartRows = document.querySelectorAll('tbody tr[data-product-id]');

        cartRows.forEach(row => {
            const price = parseFloat(row.querySelector('.price-col').innerText.replace('₹', ''));
            const quantityInput = row.querySelector('.quantity-col input');
            const quantity = parseInt(quantityInput.value);
            const total = price * quantity;

            row.querySelector('.total-col').innerText = `₹${total.toFixed(2)}`;
            subtotal += total;

            // Update cart when quantity changes
            quantityInput.addEventListener('change', () => {
                updateCart(row.dataset.productId, quantityInput.value);
                updateTotals(); // Ensure totals are updated when quantity changes
            });
        });

        // Update subtotal
        document.querySelector('#subtotal').innerText = `₹${subtotal.toFixed(2)}`;

        // Update shipping cost based on selected option
        let shippingCost = 0;
        const selectedShipping = document.querySelector('input[name="shipping"]:checked');
        if (selectedShipping) {
            shippingCost = parseFloat(selectedShipping.nextElementSibling.innerText.replace('$', ''));
        }

        // Update total
        const total = subtotal + shippingCost;
        document.querySelector('#total').innerText = `₹${total.toFixed(2)}`;
    }

    // Event listener for quantity changes
    document.querySelectorAll('.quantity-col input').forEach(input => {
        input.addEventListener('input', updateTotals);
    });

    // Event listeners for shipping options
    document.querySelectorAll('input[name="shipping"]').forEach(input => {
        input.addEventListener('change', updateTotals);
    });

    // Initial update on page load
    updateTotals();

    // Attach event listener to remove buttons
    document.querySelectorAll('.btn-remove').forEach(button => {
        button.addEventListener('click', function(event) {
            event.preventDefault(); // Prevent default form submission
            const productId = this.dataset.productId;
            removeFromCart(productId);
        });
    });
});









</script>




