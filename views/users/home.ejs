                                    "loop": false,
                                    "responsive": {
                                        "0": {
                                            "items":2
                                        },
                                        "480": {
                                            "items":2
                                        },
                                        "768": {
                                            "items":3
                                        },
                                        "992": {
                                            "items":4
                                        },
                                        "1440": {
                                            "items":5
                                        }
                                    }
                                }'>
                                <% products.forEach(product => { %>
                                <div class="product">
                                    <figure class="product-media">
                                        <a href="/product-details/<%= product._id %>">
                                            <img src="/assets/uploads/<%= product.images[0] %>" alt="Product image" class="product-image">
                                        </a>
                                    </figure><!-- End .product-media -->
                    
                                    <div class="product-body">
