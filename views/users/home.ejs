                                         <p style="color: black; font: bold; margin-left: 15px;"><%= product.productName %></p>
                                        </div>
                                        <div class="product-cat" style="margin-left: 40px;">
                                            by <a href="#"><%= product.author %></a>
                                        </div><!-- End .product-cat -->
                                        <h3 class="product-title">
                                            <a href="/product-details/<%= product._id %>"><%= product.title %></a>
                                        </h3><!-- End .product-title -->
                                        <div class="product-price" style="margin-left: 60px;">
                                            $<%= product.price.toFixed(2) %>
                                        </div><!-- End .product-price -->
                    
                                        <div class="product-footer">
                                            <div class="ratings-container">
                                                <div class="ratings">
                                                    <div class="ratings-val" ></div><!-- End .ratings-val -->
                                                </div><!-- End .ratings -->
                                                <span class="ratings-text">( <%= product.reviews %> Reviews )</span>
                                            </div><!-- End .ratings-container -->
                                            <% if (product.stock > 0) { %>
                                                <a href="" class="btn-product btn-cart add-to-cart-btn" data-product-id="<%= product._id %>" data-quantity="1">
                                                    <span>Add to cart</span>
                                                </a>
                                            <% } else { %>
                                                <span class="btn-product btn-cart disabled">Out of Stock</span>
                                            <% } %>
                                            <div class="product-action">
                                                        
                                                <a href="#" class="btn-product btn-wishlist" title="Wishlist" data-product-id="<%= product._id %>">
                                                    <span>Add to Wishlist</span>
                                                </a>                                            
                                            </div><!-- End .product-action -->
                                        </div><!-- End .product-footer -->
                                    </div><!-- End .product-body -->
                                </div><!-- End .product -->
                            <% }) %>                             
                            </div><!-- End .owl-carousel -->
                        </div><!-- End .container -->
                    </div><!-- End .block-wrapper -->
