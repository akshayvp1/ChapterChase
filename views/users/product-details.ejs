<style>
.product-gallery-item {
  display: inline-block;
  margin-right: 10px; 
}

.product-gallery-item img {
  max-width: 100%;
  height: auto;
  cursor: pointer;
}

/* price */
 .product-price {
    text-align: center; 
    font-size: 1.2rem; 
    position: relative; 
}

.product-price-original {
    display: inline-block; 
    text-decoration: line-through;
    color:red; 
    margin-right: 8px;
    margin-top: 3px; 
    position: relative; 
    vertical-align: middle;
    font-size: 15px;

}

.product-price-discounted {
    display: inline-block; 
    color:green; 
    font-weight: normal;

}

.product-price-discount {
    display: block; 
    color:green; 
    font-weight: normal; 
    margin-top: 5px;
    font-size: 15px;
    
}


.product-price-discounted-d {
    display: inline-block; 
    color:green; 
    font-size: 20px;
    margin-left: 40px;
}







.btn-wishlist.added-to-wishlist {
    background-color: #28a745;
    color: white;
}
</style>

