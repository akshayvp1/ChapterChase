    <script>
    document.addEventListener('DOMContentLoaded', function() {
    const wishlistButtons = document.querySelectorAll('.btn-wishlist');
    
    wishlistButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            const productId = this.getAttribute('data-product-id');
            
            addToWishlist(productId, this);
        });
    });
});

function addToWishlist(productId, button) {
    const span = button.querySelector('span');
    const originalText = span.textContent;

    fetch('/add-to-wishlist', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ productId: productId })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            Swal.fire({
                icon: 'success',
                title: 'Added to Wishlist',
                text: 'The product has been added to your wishlist.',
                timer: 2000, // Auto-close after 2 seconds
                showConfirmButton: false
            }).then(() => {
                button.classList.add('added-to-wishlist');
                span.textContent = 'Added to Wishlist';
                
                // Reset the button text and class after 2 seconds
                setTimeout(() => {
                    span.textContent = originalText;
                    button.classList.remove('added-to-wishlist');
                }, 2000);
                window.location.reload()
            });
        } else {
            Swal.fire({
                icon: 'warning',
                title: 'Sorry',
                text: data.message || 'There was an issue adding the product to the wishlist.',
                timer: 2000, // Auto-close after 2 seconds
                showConfirmButton: false
            }).then(() => {
                span.textContent = originalText;
            });
        }
    })
    .catch(error => {
        Swal.fire({
                    icon: 'info',
                    title: 'User Not logged in',
                    text: 'Please login.',
                    timer: 2000,
                    showConfirmButton: false
                }).then(() => {
            span.textContent = originalText;
        });
    });
}



document.addEventListener('DOMContentLoaded', () => {
    const quantityInput = document.querySelector('.quantity-input');

    // Load saved quantity from localStorage if available
    if (localStorage.getItem('productQuantity')) {
        quantityInput.value = localStorage.getItem('productQuantity');
    }

    // Function to update data-quantity attribute for the add-to-cart button
    const updateQuantityForButton = (input) => {
        const quantity = input.value;
        const addToCartBtn = input.closest('.details-filter-row').nextElementSibling.querySelector('.add-to-cart-btn');
        if (addToCartBtn) {
            addToCartBtn.dataset.quantity = quantity;
        }
    };

    // Function to check stock and show SweetAlert if needed
    const checkStock = (input) => {
        const stock = parseInt(input.dataset.productStock, 10);
        let quantity = parseInt(input.value, 10);

        if (quantity > stock) {
            input.value = stock; // Set to max available stock
            Swal.fire({
                icon: 'warning',
                title: 'Stock Limit Exceeded',
                text: `Only ${stock} product(s) left in stock.`,
                timer: 2000,
                showConfirmButton: false
            }).then(() => {
                // Disable the input field and prevent further quantity increase
                input.setAttribute('disabled', true);
                setTimeout(() => {
                    input.removeAttribute('disabled');
                }, 2000); // Re-enable input field after alert is dismissed
            });
        }

        return quantity; // Return the adjusted quantity
    };

    // Event delegation for quantity input changes
    document.addEventListener('input', (event) => {
        if (event.target.classList.contains('quantity-input')) {
            const input = event.target;
            if (!isNaN(parseInt(input.dataset.productStock, 10))) { // Ensure stock is a valid number
                const quantity = checkStock(input); // Check stock and show SweetAlert if needed
                updateQuantityForButton(input); // Update quantity for the add-to-cart button
                localStorage.setItem('productQuantity', input.value); // Save quantity to localStorage
            }
        }
    });

    // Event delegation for add to cart button clicks
    document.addEventListener('click', async (event) => {
        const addToCartBtn = event.target.closest('.add-to-cart-btn');
        if (addToCartBtn) {
            event.preventDefault();
            const productId = addToCartBtn.dataset.productId;
            const quantity = addToCartBtn.dataset.quantity || '1'; // Default to 1 if not set

            try {
                const response = await fetch('/add-to-cart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ productId, quantity })
                });

                const responseData = await response.json();

                if (response.ok) {
                    // Item added successfully
                    const originalText = addToCartBtn.innerHTML;
                    addToCartBtn.innerHTML = '<span>Added to Cart</span>';
                    Swal.fire({
                        icon: 'success',
                        title: 'Added to Cart',
                        text: `You added ${quantity} item(s) to your cart.`,
                        timer: 2000,
                        showConfirmButton: false
                    });
                    setTimeout(() => {
                        addToCartBtn.innerHTML = originalText;
                        localStorage.removeItem('productQuantity'); // Clear quantity from localStorage
                        window.location.reload(); // Refresh the page
                    }, 2000);
                    
                } else {
                    // Handle errors returned from the server
                    Swal.fire({
                        icon: 'info',
                        title: 'No Available Stock',
                        text: responseData.message || 'The product is not available in the requested quantity.',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An error occurred while adding to the cart.',
                    timer: 2000,
                    showConfirmButton: false
                });
            }
        }
    });
});





