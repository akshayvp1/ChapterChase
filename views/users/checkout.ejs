<%- include('../layouts/header.ejs') %>



<style>
.ff{
    margin-left: 80px;
}

/* General Container Styling */
.container {
    padding: 15px; /* Ensure padding for better spacing on all screens */
}

/* Form Styling */
#checkoutForm, #couponCode {
    width: 100%; /* Full width for forms on all devices */
    margin-bottom: 15px; /* Margin between forms and other elements */
}

/* Buttons Styling */
.apply-button, .apply-buttons {
    width: 100%; /* Full width for buttons */
    display: block; /* Ensure buttons stack vertically */
    margin-top: 10px; /* Space between buttons */
}

/* Modal Styling */
.modal-dialog {
    max-width: 90vw; /* Responsive max-width for modals */
    margin: 30px auto; /* Center modal horizontally */
}

.modal-content {
    border-radius: 8px; /* Rounded corners for modal */
}

/* Address Card Styling */
.card-dashboard {
    margin: 0 auto; /* Center the card */
    width: 100%; /* Full width for cards on small screens */
    max-width: 800px; /* Larger max-width for big screens */
}

/* Address Card Body Styling */
.card-body {
    padding: 15px; /* Adjust padding for better appearance */
}

/* Actions Inside Address Cards */
.actions {
    position: relative; /* Changed from absolute to relative for better responsiveness */
    display: flex;
    justify-content: flex-end; /* Align actions to the end */
    gap: 10px; /* Space between buttons */
    margin-top: 10px; /* Margin above actions */
}

.actions a {
    display: inline-block; /* Inline display for buttons */
}

/* Action Buttons Styling */
.actions a.edit {
    background-color: #28a745; /* Green background for Edit button */
    border-color: #28a745; /* Green border for Edit button */
    color: #fff;
}

.actions a.delete {
    background-color: #dc3545; /* Red background for Delete button */
    border-color: #dc3545; /* Red border for Delete button */
    color: #fff;
}

/* Button Hover Effects */
.actions a:hover {
    opacity: 0.8;
}

/* Order Summary Section */
.summary {
    margin: 20px 0; /* Margin around summary */
}

.table-summary {
    width: 100%; /* Full width for tables */
    border-collapse: collapse; /* Collapse table borders */
}

.table-summary th, .table-summary td {
    padding: 8px; /* Padding for table cells */
}

.summary-title {
    font-size: 1.25rem; /* Font size for summary title */
}

/* Responsive Styles */
@media (max-width: 1200px) {
    .card-dashboard {
        padding: 12px;
        max-width: 700px; /* Slightly smaller max-width for medium screens */
    }

    .actions {
        margin-top: 8px; /* Margin above actions */
    }
}

@media (max-width: 992px) {
    .card-dashboard {
        padding: 10px;
        max-width: 600px; /* Smaller max-width for smaller screens */
    }

    .actions {
        margin-top: 6px; /* Margin above actions */
    }

    .summary {
        margin: 15px 0; /* Adjust margin */
    }
}

@media (max-width: 768px) {
    .card-dashboard {
        padding: 8px;
        max-width: 500px; /* Further reduce max-width */
    }

    .actions {
        margin-top: 5px; /* Margin above actions */
    }

    .summary-title {
        font-size: 1rem; /* Smaller title font size */
    }

    .table-summary th, .table-summary td {
        display: block; /* Block display for table cells */
        width: 100%; /* Full width for table cells */
    }
}

@media (max-width: 576px) {
    .card-dashboard {
        padding: 6px;
        max-width: 400px; /* Smaller max-width for very small screens */
        font-size: 0.75rem; /* Smaller text */
        width: calc(100% - 20px); /* Ensure card fits well */
    }

    .actions {
        margin-top: 4px; /* Margin above actions */
    }

    .summary-title {
        font-size: 0.875rem; /* Smaller title font size */
    }

    .table-summary th, .table-summary td {
        font-size: 0.875rem; /* Adjust font size for table cells */
    }

    .modal-content {
        padding: 15px; /* Padding inside modal */
    }
}

@media (max-width: 400px) {
    .card-dashboard {
        padding: 5px;
        max-width: 300px; /* Even smaller max-width for extra small screens */
        font-size: 0.7rem; /* Smaller text */
        width: calc(100% - 10px); /* Ensure card fits well */
    }

    .actions {
        margin-top: 2px; /* Margin above actions */
    }

    .summary-title {
        font-size: 0.75rem; /* Further reduced title font size */
    }

    .table-summary th, .table-summary td {
        font-size: 0.7rem; /* Smaller font size for table cells */
    }
}









/*  */

 /* Modal Header */
 .modal-header {
    background-color: #f1f1f1; /* Subtle background */
    border-bottom: 1px solid #e0e0e0; /* Light border */
    padding: 1rem; /* Adequate padding */
  }
  
  .modal-title {
    font-size: 1.5rem; /* Larger font size for title */
    font-weight: 600; /* Slightly heavier font weight */
  }
  
  .btn-close {
    background: rgb(240, 232, 232);
    width: 40px; /* Remove default background */
    height: 40px;
    border: black; /* Remove border */
    font-size: 10px; /* Larger close button */
    color: #030303; /* Dark color for close button */
  }
  
  /* Modal Body */
  .modal-body {
    padding: 2rem; /* More padding for spacious feel */
  }
  
  /* Form Styles */
  .form-label {
    font-weight: 600; /* Bold labels */
    margin-bottom: .5rem; /* Space between label and input */
  }
  
  .form-control {
    border-radius: .375rem; /* Rounded corners */
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.1); /* Subtle shadow */
    font-size: 1.125rem; /* Increased font size for input text */
  }
  
  .form-control:focus {
    border-color: #007bff; /* Focus border color */
    box-shadow: 0 0 0 .2rem rgba(38, 143, 255, 0.25); /* Focus shadow */
  }
  
 
  
  .text-center {
    text-align: center; /* Center alignment */
  }
  
  /* Modal Dialog */
  .modal-dialog {
    max-width: 700px; /* Increased max width for larger modal */
    margin: 1.75rem auto; /* Center modal vertically */
  }
  
  /* Modal Content */
  .modal-content {
    border-radius: .375rem; /* Rounded corners for content */
  }


