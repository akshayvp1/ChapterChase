document.addEventListener('DOMContentLoaded', () => {
  // Event listener for edit buttons
  document.querySelectorAll('.edit').forEach(button => {
    button.addEventListener('click', async (event) => {
      event.preventDefault();
      const addressId = button.getAttribute('data-id');
      try {
        const response = await fetch(`/get-address/${addressId}`);
        if (response.ok) {
          const address = await response.json();
          console.log('Fetched address:', address); // Add this line
          populateEditModal(address);
        } else {
          console.error('Failed to fetch address details');
        }
      } catch (error) {
        console.error('Error fetching address details:', error);
      }
    });
  });

  function populateEditModal(address) {
    document.getElementById('editAddressId').value = address._id;
    document.getElementById('editAddressName').value = address.addressName;
    document.getElementById('editAddressEmail').value = address.addressEmail;
    document.getElementById('editAddressMobile').value = address.addressMobile;
    document.getElementById('editAddressHouse').value = address.addressHouse;
    document.getElementById('editAddressStreet').value = address.addressStreet;
    document.getElementById('editAddressPost').value = address.addressPost;
    document.getElementById('editAddressCity').value = address.addressCity;
    document.getElementById('editAddressDistrict').value = address.addressDistrict;
    document.getElementById('editAddressState').value = address.addressState;
    document.getElementById('editAddressPin').value = address.addressPin;

    const editAddressModal = new bootstrap.Modal(document.getElementById('editAddressModal'));
    editAddressModal.show();
}

  // Event listener for edit form submission
  document.getElementById('editAddressForm').addEventListener('submit', async (event) => {
  event.preventDefault();
  
  const form = event.target;
  const formData = new FormData(form);
  const addressId = formData.get('addressId');
  
  try {
    const response = await fetch(`/edit-address/${addressId}`, {
      method: 'PATCH',
      body: JSON.stringify(Object.fromEntries(formData)),
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
      }
    });

    const result = await response.json();

    if (response.ok) {
      console.log('Update successful:', result);
      
      // Try to close the modal
      try {
        const editAddressModal = document.getElementById('editAddressModal');
        if (editAddressModal) {
          const bsModal = bootstrap.Modal.getInstance(editAddressModal);
          if (bsModal) {
            bsModal.hide();
          } else {
            editAddressModal.style.display = 'none';
            document.body.classList.remove('modal-open');
            const modalBackdrop = document.querySelector('.modal-backdrop');
            if (modalBackdrop) {
              modalBackdrop.remove();
            }
          }
        }
      } catch (modalError) {
        console.error('Error closing modal:', modalError);
      }

      // Update the address in the list
      updateAddressInList(result);
      
        Swal.fire({
        icon: 'success',
        title: 'Success!',
        text: 'Address updated successfully!',
    }).then(() => {
        window.location.reload();  // Reloads the page after the user clicks "OK" in the success alert
    });


      // Reload the page after a short delay
      setTimeout(() => {
        window.location.reload();
      }, 1500);

    } else {
      throw new Error(result.message || 'Failed to update address');
    }
  } catch (error) {
    console.error('Error updating address:', error);
    Swal.fire({
      icon: 'error',
      title: 'Oops...',
      text: `An error occurred while updating the address: ${error.message}`,
    });
  }
});

function updateAddressInList(updatedAddress) {
  try {
    const addressList = document.getElementById('addressList');
    const addressCards = addressList.querySelectorAll('.card-dashboard');

    addressCards.forEach(card => {
      const editButton = card.querySelector('.edit');
      if (editButton && editButton.getAttribute('data-id') === updatedAddress._id) {
        card.querySelector('.card-title').textContent = updatedAddress.addressName;
        const addressParagraph = card.querySelector('p');
        if (addressParagraph) {
          addressParagraph.innerHTML = `
            ${updatedAddress.addressHouse || ''}<br>
            ${updatedAddress.addressStreet || ''}<br>
            ${updatedAddress.addressPost || ''}, ${updatedAddress.addressCity || ''}<br>
            ${updatedAddress.addressState || ''}<br>
            Pin: ${updatedAddress.addressPin || ''}<br>
            ${updatedAddress.addressEmail || ''}<br>
            Mobile: ${updatedAddress.addressMobile || ''}<br>
          `;
        }
      }
    });
  } catch (error) {
    console.error('Error updating address in list:', error);
  }
}
});



   // Attach event listeners to delete buttons
   document.querySelectorAll('.delete').forEach(button => {
