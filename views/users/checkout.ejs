document.getElementById('checkoutForm').addEventListener('submit', function(event) {
    event.preventDefault(); // Prevent the default form submission

    // Get the selected address
    const selectedAddress = document.querySelector('input[name="selectedAddress"]:checked')?.value;
    console.log('Selected Address:', selectedAddress);

    // Get the cart items
    const cartItems = Array.from(document.querySelectorAll('tr[data-product-id]')).map(row => {
        return {
            productId: row.getAttribute('data-product-id'),
            quantity: row.getAttribute('data-product-qty')
        };
    });
    console.log('Cart Items:', cartItems);

    // Calculate total price
    let totalPrice = 0;
    document.querySelectorAll('.summary-total td').forEach(td => {
        const priceText = td.innerText.replace('$', '');
        const price = parseFloat(priceText);
        if (!isNaN(price)) totalPrice += price;
    });
    console.log('Total Price:', totalPrice);

    // Determine the payment method based on which accordion section is open
    const paymentMethod = document.querySelector('#accordion-payment .collapse.show').id === 'collapse-3' ? 'Cash on Delivery' : 'RazorPay';
    console.log('Payment Method:', paymentMethod);

    // Prepare the data to send
    const orderData = {
        selectedAddress,
        cartItems,
        totalPrice: totalPrice || 0,
        paymentMethod
    };
    console.log('Order Data:', orderData);

    if (paymentMethod === 'RazorPay') {
        // RazorPay payment flow
        fetch('/create-order', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ amount: totalPrice })
        })
        .then(response => response.json())
        .then(data => {
            var options = {
                key: '<%= process.env.RAZORPAY_KEY_ID %>', // Replace with your actual key
                amount: data.amount,
                currency: data.currency,
                name: 'Your Company Name',
                description: 'Purchase Description',
                order_id: data.orderId,
                handler: function(response) {
                    // Add the Razorpay payment details to orderData
                    orderData.razorpayPaymentId = response.razorpay_payment_id;
                    orderData.razorpayOrderId = response.razorpay_order_id;
                    orderData.razorpaySignature = response.razorpay_signature;

                    // Now place the order with the Razorpay details
                    placeOrder(orderData);
                },
                prefill: {
                    name: 'Customer Name',
                    email: 'customer@example.com',
                    contact: '9999999999'
                },
                theme: {
                    color: '#F37254'
                }
            };
            var rzp = new Razorpay(options);
            rzp.open();
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire({
                title: 'Error!',
                text: 'Failed to initialize RazorPay payment.',
                icon: 'error',
                confirmButtonText: 'OK'
            });
        });
    } else {
        // Cash on Delivery flow
        placeOrder(orderData);
    }
});

function placeOrder(orderData) {
    fetch('/place-order', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(orderData)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            Swal.fire({
                title: 'Success!',
                text: 'Order placed successfully!',
                icon: 'success',
                confirmButtonText: 'OK'
            }).then(() => {
                window.location.href = `/order-summary/${data.orderId}`;
            });
        } else {
            Swal.fire({
                title: 'Failed!',
                text: 'Failed to place the order. Reason: ' + (data.message || 'Unknown error'),
                icon: 'error',
                confirmButtonText: 'OK'
            });
        }
    })
    .catch(error => {
        console.error('Error:', error);
        Swal.fire({
            title: 'Error!',
            text: 'An error occurred while placing the order.',
            icon: 'error',
            confirmButtonText: 'OK'
        });
    });
}














 
