/* Set the width and height of the address cards */
.card-dashboard {
    width: 900px;
    height: 290px;
    overflow: hidden; /* Ensures content that overflows is hidden */
    margin-bottom: 20px; /* Adds space between cards */
    border-radius: 0px; /* Optional: Rounded corners */
    box-shadow: 0 4px 8px rgba(56, 7, 7, 0.1); /* Optional: Shadow for better visibility */
}

/* Ensure the card body takes the full height of the card */
.card-body {
    height: 100%; /* Full height of the card */
    padding: 15px; /* Adjust padding as needed */
    box-sizing: border-box; /* Include padding and border in the element's total width and height */
}




/* Style for the coupon list container */
.coupon-list {
    max-height: 400px; /* Adjust height as needed */
    overflow-y: auto;
}

/* Style for each coupon item */
.coupon-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid #ddd;
    border-radius: 5px;
    padding: 10px;
    margin-bottom: 10px;
}

/* Style for coupon details */
.coupon-details {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 15px; /* Space between details */
}

.coupon-code,
.coupon-min-amount,
.coupon-redeem-amount {
    font-size: 14px;
    color: #333;
}

/* Style for the copy button */
.copy-btn {
    margin-left: 10px;
}

/* Style for the description text */
.description {
    margin-left: 10px;
    color: #555;
}












