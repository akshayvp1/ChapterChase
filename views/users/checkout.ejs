    <script>
document.getElementById('checkoutForm').addEventListener('submit', async function(event) {
    event.preventDefault();

    const selectedAddress = document.querySelector('input[name="selectedAddress"]:checked')?.value;
    const cartItems = Array.from(document.querySelectorAll('tr[data-product-id]')).map(row => ({
        productId: row.getAttribute('data-product-id'),
        quantity: parseInt(row.getAttribute('data-product-qty')),
        price: parseFloat(row.querySelector('td:nth-child(2)').textContent.replace('$', ''))
    }));

    let subtotal = parseFloat(document.getElementById('subtotal').textContent.replace('$', '')) || 0;
    let totalPrice = parseFloat(document.getElementById('total').textContent.replace('$', '')) || 0;

    const paymentMethod = document.querySelector('#accordion-payment .collapse.show').id === 'collapse-3' ? 'Cash on Delivery' :
                          document.querySelector('#accordion-payment .collapse.show').id === 'collapse-5' ? 'RazorPay' : 'Wallet';

    const couponCode = document.getElementById('couponvalue')?.value || null;
    const couponDiscountAmt = parseFloat(document.getElementById('discountAmount')?.textContent.replace('-$', '')) || 0;

    const orderData = {
        selectedAddress,
        cartItems,
        subtotal,
        totalPrice,
        paymentMethod,
        couponCode,
        couponDiscountAmt,
        paymentStatus: 'Pending'
    };

    console.log('Order Data:', orderData);

    if (paymentMethod === 'RazorPay') {
        try {
            const response = await fetch('/create-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount: Math.round(totalPrice) })
            });
            const data = await response.json();

            var options = {
                key: '<%= process.env.RAZORPAY_KEY_ID %>',
                amount: data.amount,
                currency: data.currency,
                name: 'Your Company Name',
                description: 'Purchase Description',
                order_id: data.orderId,
                handler: function(response) {
                    orderData.razorpayPaymentId = response.razorpay_payment_id;
                    orderData.razorpayOrderId = response.razorpay_order_id;
                    orderData.razorpaySignature = response.razorpay_signature;
                    orderData.paymentStatus = 'Completed';
                    placeOrder(orderData);
                },
                modal: {
                    ondismiss: function() {
                        handlePaymentFailure(orderData);
                    }
                },
                prefill: {
                    name: 'Customer Name',
                    email: 'customer@example.com',
                    contact: '9999999999'
                },
                theme: { color: '#F37254' }
            };
            var rzp = new Razorpay(options);
            rzp.open();
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                title: 'Error!',
                text: 'Failed to initialize RazorPay payment.',
                icon: 'error',
                confirmButtonText: 'OK'
            });
        }
    } else if (paymentMethod === 'Wallet') {
        try {
            const response = await fetch('/debit-wallet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ totalPrice })  // Ensure totalPrice is sent
            });
            const data = await response.json();

            if (data.success) {
                orderData.paymentStatus = 'Completed';
                placeOrder(orderData);
            } else {
                Swal.fire({
                    title: 'Insufficient Funds',
                    text: 'Your wallet does not have sufficient funds for this order.',
                    icon: 'warning',
                    confirmButtonText: 'OK'
                });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                title: 'Error!',
                text: 'Failed to debit from wallet.',
                icon: 'error',
                confirmButtonText: 'OK'
            });
        }
    } else {
        placeOrder(orderData);
    }
});

function handlePaymentFailure(orderData) {
    orderData.paymentStatus = 'Failed';
    placeOrder(orderData);
}

async function placeOrder(orderData) {
    if (orderData.paymentMethod === 'Cash on Delivery' && orderData.totalPrice > 1000) {
        Swal.fire({
            title: 'Cash on Delivery Unavailable',
            text: 'You cannot use Cash on Delivery for orders above 1000. Please choose another payment method.',
            icon: 'warning',
            confirmButtonText: 'OK'
        });
        return; // Prevent the form submission
    }

    try {
        const response = await fetch('/place-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(orderData)
        });
        const data = await response.json();

        if (data.success) {
            if (orderData.paymentStatus === 'Failed') {
                Swal.fire({
                    title: 'Payment Failed',
                    text: 'Your order has been pending. You can retry the payment later.',
                    icon: 'warning',
                    confirmButtonText: 'OK'
                }).then(() => {
                    window.location.href = '/user-order';
                });
            } else {
                Swal.fire({
                    title: 'Success!',
                    text: 'Order placed successfully!',
                    icon: 'success',
                    confirmButtonText: 'OK'
                }).then(() => {
                    window.location.href = `/order-summary/${data.orderId}`;
                });
            }
        } else {
            Swal.fire({
                title: 'Failed!',
                text: 'Failed to place the order. Reason: ' + (data.message || 'Unknown error'),
                icon: 'error',
                confirmButtonText: 'OK'
            });
        }
    } catch (error) {
        console.error('Error:', error);
        Swal.fire({
            title: 'Error!',
            text: 'An error occurred while placing the order.',
            icon: 'error',
            confirmButtonText: 'OK'
        });
    }
}






//copy coupon code
document.addEventListener('DOMContentLoaded', function () {
    // Function to copy text to the clipboard
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function() {
            console.log('Copying to clipboard was successful!');
        }, function(err) {
            console.error('Could not copy text: ', err);
        });
    }

    // Add event listeners to all copy buttons
    document.querySelectorAll('.copy-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            var couponCode = this.getAttribute('data-coupon');
            copyToClipboard(couponCode);

            // Provide feedback
            var description = this.nextElementSibling; // Assuming the <p class="description"></p> is right after the button
            description.textContent = 'Coupon code copied!';
            description.style.color = 'green'; // Optional: Change text color to indicate success

            // Optional: Remove feedback after a few seconds
            setTimeout(function() {
                description.textContent = '';
            }, 2000);
        });
    });
});







//add coupon
document.getElementById('couponCode').addEventListener('submit', async (event) => {
    event.preventDefault();

    const couponCode = document.getElementById('couponvalue').value.trim();

    if (!couponCode) {
        Swal.fire({
            icon: 'warning',
            title: 'No Coupon Code',
            text: 'Please enter a coupon code.',
        });
        return;
    }

    try {
        const response = await fetch('/apply-coupon', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ couponCode }),
        });

        const data = await response.json();

        if (data.success) {
            // Update the discount amount
            const discountRow = document.getElementById('discountRow');
            const discountAmount = document.getElementById('discountAmount');
            discountRow.style.display = 'table-row';
            discountAmount.textContent = `-$${data.discountAmount.toFixed(2)}`;

            // Update the total
            const totalElement = document.getElementById('total');
            totalElement.textContent = `$${data.newTotal.toFixed(2)}`;

            // Update the prices of each product
            const cartItems = data.discountedItems;
            cartItems.forEach(item => {
                const productRow = document.querySelector(`[data-product-id="${item.product._id}"]`);
                if (productRow) {
                    const discountedPriceCell = productRow.querySelector('td:last-child'); // Assuming price is in the last cell
                    discountedPriceCell.textContent = `$${item.discountedTotal.toFixed(2)}`;
                }
            });

            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: 'Coupon applied successfully!',
            });
        } else {
            // If the coupon was already used, show a SweetAlert
            Swal.fire({
                icon: 'warning',
                title: 'Not allowed',
                text: data.message || 'You have already used this coupon.',
            });
        }
    } catch (error) {
        console.error('Error applying coupon:', error);
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred while applying the coupon.',
        });
    }
});






//remove coupon
document.getElementById('remove').addEventListener('click', async (event) => {
    event.preventDefault();

    // Show confirmation alert
    const result = await Swal.fire({
        title: 'Are you sure?',
        text: 'Do you want to remove the discount?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Yes, remove it!',
        cancelButtonText: 'No, keep it',
    });

    if (result.isConfirmed) {
        // Hide the discount row
        const discountRow = document.getElementById('discountRow');
        discountRow.style.display = 'none';

        // Reset the discount amount
        const discountAmount = document.getElementById('discountAmount');
        discountAmount.textContent = `-$0.00`;

        // Calculate the new total (assuming subtotal is stored in a variable)
        const subtotal = parseFloat(document.getElementById('subtotal').textContent.replace('$', ''));
        const totalElement = document.getElementById('total');
        totalElement.textContent = `$${subtotal.toFixed(2)}`;

        // Show success message
        Swal.fire({
            icon: 'success',
            title: 'Removed!',
            text: 'Discount has been removed successfully.',
        });
    }
});












