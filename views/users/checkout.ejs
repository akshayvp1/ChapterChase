                        <form id="checkoutForm" method="POST" action="/place-order">
                            <div class="row">
                                <div class="col-lg-9">
                                    <div class="address-header">
                                        <a href="/user-address" id="addNewAddress" class="btn btn-primary">Add New Address</a>
                                    </div>
                                    
                        
                                    <div class="row" id="addressList">
                                        <% if (addresses && addresses.length > 0) { %>
                                            <% addresses.forEach(function(address, index) { %>
                                                <div class="col-lg-6">
                                                    <div class="card card-dashboard">
                                                        <div class="card-body">
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="radio" name="selectedAddress" id="address<%= index %>" value="<%= address._id %>" <%= index === 0 ? 'checked' : '' %>>
                                                                <label class="form-check-label" for="address<%= index %>">
                                                                    <h3 class="card-title"><%= address.addressName %></h3>
                                                                    <p>
                                                                        <%= address.addressHouse %><br>
                                                                        <%= address.addressStreet %><br>
                                                                        <%= address.addressPost %>, <%= address.addressCity %><br>
                                                                        <%= address.addressState %><br>
                                                                        Pin: <%= address.addressPin %><br>
                                                                        <%= address.addressEmail %><br>
                                                                        Mobile: <%= address.addressMobile %><br>
                                                                    </p>
                                                                </label>
                                                            </div>
                                                            <div class="actions">
                                                                <a href="#" class="edit" data-id="<%= address._id %>">Edit <i class="icon-edit"></i></a>
                                                                <a href="#" class="delete" data-id="<%= address._id %>">Delete</a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        <% } else { %>
                                            <p>No addresses found. Please add an address.</p>
                                        <% } %>
                                    </div>
                        
                                </div><!-- End .col-lg-9 -->



                              
                                
                              

                        
                                <aside class="col-lg-3">
                                    <div class="summary">
                                        <h3 class="summary-title">Your Order</h3>
                        
                                        <table class="table table-summary">
                                            <thead>
                                                <tr>
                                                    <th>Product</th>
                                                    <th></th>
                                                    <th></th>
                                                    <th>Total</th>
                                                </tr>
                                            </thead>
                        
                                            <tbody>
                                                <% cartItems.forEach(item => { %>
                                                    <tr data-product-id="<%= item.product._id %>" data-product-qty="<%= item.quantity %>">
                                                        <td><a href="/product-details/<%= item.product._id %>"><%= item.product.productName %></a></td>
                                                        <td>
                                                            <% if (item.discountPercentage > 0) { %>
                                                                <span class="product-price-discounted">
                                                                </span>
                                                                <span class="product-price-original">
                                                                </span>
                                                            
                                                            <% } %>
                                                        </td>
                                                        <td></td>
                                                        <td>$<%= item.total.toFixed(2) %></td>
                                                    </tr>
                                                <% }); %>
                                                <tr class="summary-subtotal">
                                                    <td colspan="3">Subtotal:</td>
                                                    <td>$<%= subtotal.toFixed(2) %></td>
                                                </tr>
                                                <tr class="summary-total">
                                                    <td colspan="3">Total:</td>
                                                    <td>$<%= total.toFixed(2) %></td>
                                                </tr>
                                            </tbody>
                                        </table>
                        
                                        <form id="checkoutForm" method="POST" action="/place-order">
                                            <div class="accordion-summary" id="accordion-payment">
                                                <!-- Cash on Delivery -->
                                                <div class="card">
                                                    <div class="card-header" id="heading-3">
                                                        <h2 class="card-title">
                                                            <a role="button" data-toggle="collapse" href="#collapse-3" aria-expanded="true" aria-controls="collapse-3">
                                                                Cash on delivery
                                                            </a>
                                                        </h2>
                                                    </div>
                                                    <div id="collapse-3" class="collapse show" aria-labelledby="heading-3" data-parent="#accordion-payment">
                                                        <div class="card-body">
                                                            Pay with cash upon delivery of your order. No need for online payment.
                                                        </div>
                                                    </div>
                                                </div>
                                        
                                                <!-- RazorPay -->
                                                <div class="card">
                                                    <div class="card-header" id="heading-5">
                                                        <h2 class="card-title">
                                                            <a class="collapsed" role="button" data-toggle="collapse" href="#collapse-5" aria-expanded="false" aria-controls="collapse-5">
                                                                RazorPay
                                                            </a>
                                                        </h2>
                                                    </div>
                                                    <div id="collapse-5" class="collapse" aria-labelledby="heading-5" data-parent="#accordion-payment">
                                                        <div class="card-body">
                                                            Secure online payment via RazorPay. Your payment information is processed securely.
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        
                                            <button type="submit" class="btn btn-outline-primary-2 btn-order btn-block">
                                                <span class="btn-text">Place Order</span>
                                                <span class="btn-hover-text">Proceed to Checkout</span>
                                            </button>
                                        </form>
                                        
                                        
                                    </div>
                                </aside>
                            </div><!-- End .row -->
                        </form>
                        
