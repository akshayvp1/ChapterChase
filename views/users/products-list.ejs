                            <div class="products mb-3">
                                <div class="row justify-content-center">
                                    <% products.forEach(product => { %>
                                    <div class="col-6 col-md-4 col-lg-4">
                                        <% if (product.stock <= 0) { %>
                                            <span class="product-label label-low-stock">
                                                <i class="fa fa-ban"></i> Out of stock
                                            </span>
                                        <% } else if (product.stock <= 10) { %>
                                            <span class="product-label label-in-stock">
                                                <i class="fa fa-exclamation-triangle"></i> Less stock
                                            </span>
                                        <% } else { %>
                                            <span class="product-label label-in-stock">
                                                <i class="fa fa-check-circle"></i> In stock
                                            </span>
                                        <% } %>
                                        <div class="product product-7 text-center">
                                            <figure class="product-media">
                                               
                                                
                                                
                                                <a href="/product-details/<%= product._id %>">
                                                    <img src="/assets/uploads/<%= product.images[0] %>" alt="Product image" class="product-image">
                                                </a>
                                
                                                <div class="product-action-vertical">
                                                    <a href="#" class="btn-product btn-product-icon btn-wishlist btn-expandable" title="Wishlist" data-product-id="<%= product._id %>">
                                                        <span>Add to Wishlist</span>
                                                    </a>
                                                    <!-- <a href="popup/quickView.html" class="btn-product-icon btn-quickview" title="Quick view"><span>Quick view</span></a>
                                                    <a href="#" class="btn-product-icon btn-compare" title="Compare"><span>Compare</span></a> -->
                                                </div><!-- End .product-action-vertical -->
                            
                                                <% if (product.stock > 0) { %>
                                                    <a href="" class="btn-product btn-cart add-to-cart-btn" data-product-id="<%= product._id %>" data-quantity="1">
                                                        <span>Add to cart</span>
                                                    </a>
                                                <% } else { %>
                                                    <span class="btn-product btn-cart disabled">Out of Stock</span>
                                                <% } %>
                            
                                                <div class="product-action"></div><!-- End .product-action -->
                                            </figure><!-- End .product-media -->
                            
                                            <div class="product-body">
                                                <div class="product-cat">
                                                    <a href="#"><%= product.category %></a>
                                                </div><!-- End .product-cat -->
                                                <h3 class="product-title"><a href="<%= product.href %>"><%= product.productName %></a></h3><!-- End .product-title -->
                                            
                                                <div class="product-price">
                                                    <% 
                                                        let discountedPrice = product.price;
                                                        let bestDiscountPercentage = 0;
                                                        
                                                        // Find the best product-specific offer (if any)
                                                        const productOffers = offers.filter(o => 
                                                            o.offerType === 'product' && o.productId.includes(product._id.toString())
                                                        );
                                                        
                                                        // Check if there's any product-specific offer
                                                        if (productOffers.length > 0) {
                                                            // Find the product-specific offer with the highest discount
                                                            const bestProductOffer = productOffers.reduce((max, offer) => 
                                                                offer.discount > max.discount ? offer : max, productOffers[0]);
                                                            
                                                            bestDiscountPercentage = bestProductOffer.discount;
                                                            discountedPrice = product.price - (product.price * (bestDiscountPercentage / 100));
                                                        }
                                                        
                                                        // Now check all category offers and see if any offer a better discount
                                                        offers.forEach(offer => {
                                                            if (offer.offerType === 'category' && offer.categoryId.includes(product.category.toString())) {
                                                                const currentDiscountPercentage = offer.discount;
                                                                if (currentDiscountPercentage > bestDiscountPercentage) {
                                                                    bestDiscountPercentage = currentDiscountPercentage;
                                                                    discountedPrice = product.price - (product.price * (bestDiscountPercentage / 100));
                                                                }
                                                            }
                                                        });
                                                    %>
                                            
                                                    <% if (bestDiscountPercentage > 0) { %>
                                                        <span class="product-price-discounted">
                                                            ₹<%= discountedPrice.toFixed(2) %>
                                                        </span>
                                                        <span class="product-price-original">
                                                            ( ₹<%= product.price.toFixed(2) %> )
                                                        </span>
                                                        <span class="product-price-discount">
                                                            <%= bestDiscountPercentage %>% Off
                                                        </span>
                                                    <% } else { %>
                                                        ₹<%= product.price.toFixed(2) %>
                                                    <% } %>
                                                </div><!-- End .product-price -->
                                            
                                                <div class="ratings-container">
                                                    <div class="ratings">
                                                        <div class="ratings-val" style="width: 20%;"></div>
                                                    </div><!-- End .ratings -->
                                                    <span class="ratings-text">( 2 Reviews )</span>
                                                </div><!-- End .ratings-container -->
                                            </div><!-- End .product-body -->
                                            
                                            
                                            
                                            
                                            
                                            
                                            
                                        </div><!-- End .product -->
                                    </div><!-- End .col-sm-6 col-lg-4 -->
                                    <% }) %>
                                </div><!-- End .row -->
                            </div><!-- End .products -->
                            







