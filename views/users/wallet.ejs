<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Wallet</title>
    <link rel="stylesheet" href="styles.css">
    <style>
        /* General styles */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f4f9;
}

.wallet-container {
    max-width: 600px;
    margin: 50px auto;
    padding: 20px;
    background-color: #fff;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

h1, h2 {
    text-align: center;
    color: #333;
}

/* Balance section */
.balance-container {
    text-align: center;
    margin-bottom: 30px;
}

.balance-amount {
    font-size: 2.5em;
    color: #4caf50;
}

/* Transactions section */
.transactions-container {
    margin-top: 20px;
}

.transaction-list {
    list-style-type: none;
    padding: 0;
    margin: 0;
}

.transaction-item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 15px;
    margin-bottom: 10px;
    border-radius: 5px;
    background-color: #f9f9f9;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.transaction-item.credit {
    border-left: 5px solid #4caf50;
}

.transaction-item.debit {
    border-left: 5px solid #f44336;
}

.transaction-id, .transaction-date, .transaction-description, .transaction-amount {
    margin: 2px 0;
}

.transaction-amount {
    font-weight: bold;
}

.transaction-item.credit .transaction-amount {
    color: #4caf50;
}

.transaction-item.debit .transaction-amount {
    color: #f44336;
}

    </style>
</head>
<body>
    <div class="wallet-container">
        <h1>User Wallet</h1>

        <div class="balance-container">
            <h2>Balance</h2>
            <div class="balance-amount">₹<span id="walletBalance"><%= wallet.balance.toFixed(2) %></span></div>
        </div>

        <div class="transactions-container">
            <h2>Transactions</h2>
            <ul class="transaction-list" id="transactionList">
                <% wallet.transactions.forEach(transaction => { %>
                    <li class="transaction-item <%= transaction.type %>">
                        <div class="transaction-id">Transaction ID: <%= transaction.transactionId %></div>
                        <div class="transaction-date">Date: <%= transaction.date.toISOString().split('T')[0] %></div>
                        <div class="transaction-description"><%= transaction.description %></div>
                        <div class="transaction-amount">
                            ₹<%= transaction.type === 'credit' ? '+' : '-' %><%= Math.abs(transaction.amount).toFixed(2) %>
                        </div>
                    </li>
                <% }); %>
            </ul>
        </div>
    </div>
</body>
</html>
