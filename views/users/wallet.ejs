<style>
/* Wallet Section Container */
.wallet-container {
    width: 100%;
    max-width: 1200px;
    margin: 20px auto;
    font-family: 'Arial', sans-serif;
    color: #333;
    padding: 0 20px;
    box-sizing: border-box;
}

/* Wallet Card Styling */
.wallet-card {
    background-color: #9290ca;
    color: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
    text-align: center;
    margin-bottom: 30px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.wallet-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 20px rgba(0, 0, 0, 0.3);
}

.wallet-card h2 {
    margin: 0 0 15px;
    font-size: 2em;
}

.wallet-card .balance {
    font-size: 3em;
    font-weight: bold;
    color: rgb(24, 8, 8);
}

/* Transactions Table Styling */
.transactions-container {
    background-color: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
    overflow-x: auto; /* Allow scrolling on smaller screens */
}

.transactions-container h2 {
    margin: 0 0 20px;
    color: #333;
    font-size: 1.8em;
}

.transactions-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.2em;
}

.transactions-table th,
.transactions-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
    transition: background-color 0.3s ease;
}

.transactions-table th {
    background-color: #f8f9fa;
}

.transactions-table tbody tr:hover {
    background-color: #f1f1f1;
}

.transactions-table .status {
    padding: 8px 12px;
    border-radius: 6px;
    color: white;
    font-size: 1em;
}

.transactions-table .status.credit {
    background-color: #4CAF50;
}

.transactions-table .status.debit {
    background-color: #f44336;
}

/* Responsive Design */

/* Large Screens (max-width: 1200px) */
@media (max-width: 1200px) {
    .wallet-container {
        padding: 0 15px;
    }

    .wallet-card h2 {
        font-size: 1.8em;
    }

    .wallet-card .balance {
        font-size: 2.5em;
    }

    .transactions-container h2 {
        font-size: 1.6em;
    }

    .transactions-table th,
    .transactions-table td {
        font-size: 1.1em;
        padding: 10px;
    }
}

/* Medium Screens (max-width: 800px) */
@media (max-width: 800px) {
    .wallet-container {
        padding: 0 10px;
    }

    .wallet-card h2 {
        font-size: 1.6em;
    }

    .wallet-card .balance {
        font-size: 2.2em;
    }

    .transactions-container h2 {
        font-size: 1.4em;
    }

    .transactions-table th,
    .transactions-table td {
        font-size: 1em;
        padding: 8px;
    }
}

/* Small Screens (max-width: 600px) */
@media (max-width: 600px) {
    .wallet-card h2 {
        font-size: 1.4em;
    }

    .wallet-card .balance {
        font-size: 2em;
    }

    .transactions-container h2 {
        font-size: 1.2em;
    }

    .transactions-container {
        padding: 10px;
    }

    /* Allow the table to scroll horizontally */
    .transactions-container {
        overflow-x: auto;
    }

    /* Reduce padding for smaller screens */
    .transactions-table th,
    .transactions-table td {
        padding: 6px 8px;
        font-size: 0.9em;
    }
}

/* Extra Small Screens (max-width: 400px) */
@media (max-width: 400px) {
    .wallet-card h2 {
        font-size: 1.2em;
    }

    .wallet-card .balance {
        font-size: 1.8em;
    }

    .transactions-container h2 {
        font-size: 1em;
    }

    .transactions-table td {
        padding: 5px;
        font-size: 0.85em;
    }
}



</style>






