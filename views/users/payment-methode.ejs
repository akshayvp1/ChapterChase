<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Methods - ChapterChase</title>
    <style>
        :root {
            --primary-color: #3498db;
            --secondary-color: #2c3e50;
            --accent-color: #e74c3c;
            --background-color: #f4f4f4;
            --text-color: #333;
            --card-bg: #ffffff;
        }
        
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        
        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            color: var(--text-color);
            background-color: var(--background-color);
        }
        
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        header {
            background-color: var(--primary-color);
            color: white;
            text-align: center;
            padding: 2rem 0;
        }
        
        h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }
        
        main {
            padding: 3rem 0;
        }
        
        .payment-methods {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 2rem;
        }
        
        .payment-method {
            flex-basis: calc(33.333% - 1.33rem);
            background-color: var(--card-bg);
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 2rem;
            text-align: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .payment-method:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }
        
        .payment-method h2 {
            color: var(--secondary-color);
            margin-bottom: 1rem;
        }
        
        .payment-method p {
            margin-bottom: 1.5rem;
        }
        
        .icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }
        
        .button {
            display: inline-block;
            background-color: var(--accent-color);
            color: white;
            padding: 0.75rem 1.5rem;
            text-decoration: none;
            border-radius: 5px;
            transition: background-color 0.3s ease;
            border: none;
            cursor: pointer;
            font-size: 1rem;
        }
        
        .button:hover {
            background-color: #c0392b;
        }
        
        @media (max-width: 768px) {
            .payment-method {
                flex-basis: 100%;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <h1>Payment Methods</h1>
            <p>Choose your preferred way to pay</p>
        </div>
    </header>

    <main class="container">
        <section class="payment-methods">
            <div class="payment-method">
                <div class="icon">💳</div>
                <h2>Razorpay</h2>
                <p>Fast, secure online payments. Pay with credit/debit cards or net banking.</p>
                <button class="button">Pay with Razorpay</button>
            </div>
            
            <div class="payment-method">
                <div class="icon">💰</div>
                <h2>Cash on Delivery</h2>
                <p>Pay in cash when your order is delivered to your doorstep.</p>
                <button class="button">Choose Cash on Delivery</button>
            </div>
            
            <div class="payment-method">
                <div class="icon">👛</div>
                <h2>Wallet</h2>
                <p>Use your ChapterChase wallet balance for quick and easy payments.</p>
                <button class="button">Pay with Wallet</button>
            </div>
        </section>
    </main>
</body>
</html>