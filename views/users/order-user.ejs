                        </aside>
                         
                        <div class="col-md-8 col-lg-9">
                            <div class="tab-content">
                                <div class="search-container">
                                    <form id="search-form" action="" method="GET">
                                        <input type="search" class="form-control form-control-sm search-input" 
                                               placeholder="Search order" aria-controls="DataTables_Table_0" 
                                               id="search-input" name="search" value="<%= search %>">
                                        <button type="submit" class="btn btn-primary search-btn">Search</button>
                                    </form>
                                </div>
                                
                                <table class="order-table" id="orderTable">
                                    <thead>
                                        <tr>
                                            <th>Order ID</th>
                                            <th>Image</th>
                                            <th>Quantity</th>
                                            <th>Price</th>
                                            <th>Status</th>
                                            <th>Action</th>
                                            <th>View</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (orders.length === 0) { %>
                                            <tr>
                                                <td colspan="7">No orders found for this user.</td>
                                            </tr>
                                        <% } else { %>
                                            <% orders.forEach(order => { %>
                                                <% order.items.forEach(pro => { %>
                                                <tr>
                                                    <td>#<%= order.orderId %></td>
                                                    <td><img src="/assets/uploads/<%= pro.product.images[1] %>" alt="" style="width: 50px;height: 50px;"></td>
                                                    <td><%= pro.quantity %></td>
                                                    <td>₹<%= (pro.price * pro.quantity).toFixed(2) %></td>
                                                    <td class="status-<%= order._id %>"><%= pro.order_status %></td>
                                                    <td>
                                                        <% if (['Pending', 'Processing', 'Shipped'].includes(pro.order_status)) { %>
                                                            <button class="action-btn cancel-btn" data-order-id="<%= order._id %>">Cancel</button>
                                                        <% } else if (pro.order_status === 'Delivered') { %>
                                                            <button class="action-btn return-btn" data-order-id="<%= order._id %>">Return</button>
                                                        <% } else { %>
                                                            <button class="action-btn" disabled>No Action</button>
                                                        <% } %>
                                                    </td>
                                                    <td><button class="view-btn" data-order-id="<%= order._id %>">View</button></td>
                                                </tr>
                                                <% }) %>
                                            <% }) %>
                                        <% } %>
                                    </tbody>
                                </table>
                                
                                <!-- Pagination -->
                                <div class="pagination">
                                    <ul class="pagination-list">
                                        <% if (page > 1) { %>
                                            <li><a href="?page=<%= page - 1 %>&search=<%= search %>">&laquo; Previous</a></li>
                                        <% } %>
                                        <% for (let i = 1; i <= totalPages; i++) { %>
                                            <li class="<%= i === page ? 'active' : '' %>">
                                                <a href="?page=<%= i %>&search=<%= search %>"><%= i %></a>
                                            </li>
                                        <% } %>
                                        <% if (page < totalPages) { %>
                                            <li><a href="?page=<%= page + 1 %>&search=<%= search %>">Next &raquo;</a></li>
                                        <% } %>
                                    </ul>
                                </div>
                                


                            </div><!-- End .col-lg-9 -->
                        </div><!-- End .row -->
                        
                        
                </div><!-- End .container -->
