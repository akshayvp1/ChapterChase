<script>
function openOrderDetailsModal(orderId) {
    fetch(`/order/${orderId}`)
        .then(response => response.json())
        .then(order => {
            if (order) {
                document.querySelector('.order-id').textContent = order.orderId;
                document.querySelector('.order-date').textContent = new Date(order.createdAt).toLocaleDateString();
                document.querySelector('.total-amount').textContent = order.totalPrice.toFixed(2);
                order.items.forEach(product => {
                    document.querySelector('.order-status').textContent = product.order_status;
                });
                document.querySelector('.payment-type').textContent = order.paymentMethod;
                document.querySelector('.payment-status').textContent = order.payment_status;
                document.querySelector('.name').textContent = order.address.addressName;
                document.querySelector('.street').textContent = `${order.address.addressHouse}, ${order.address.addressStreet}`;
                document.querySelector('.city').textContent = order.address.addressCity;
                document.querySelector('.zip').textContent = order.address.addressPin;
                document.querySelector('.state').textContent = order.address.addressState;
                document.querySelector('.phone').textContent = order.address.addressMobile;

                const orderItemsTable = document.querySelector('.order-items-table');
                orderItemsTable.innerHTML = '';
                order.items.forEach(item => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${item.product.productName}</td>
                        <td>${item.quantity}</td>
                        <td>₹${item.product.price}</td>
                        <td>₹${item.quantity * item.product.price}</td>
                    `;
                    orderItemsTable.appendChild(row);
                });

                document.querySelector('#orderDetailsModal').style.display = 'block';
            } else {
                alert('Failed to fetch order details.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error fetching order details.');
        });
}

// Add event listeners to all view buttons
document.querySelectorAll('.view-btn').forEach(button => {
    button.addEventListener('click', function() {
        const orderId = this.getAttribute('data-order-id');
        openOrderDetailsModal(orderId);
    });
});

// Add event listeners to all action buttons
document.querySelectorAll('.action-btn').forEach(button => {
    button.addEventListener('click', function() {
        const orderId = this.getAttribute('data-order-id');
        if (this.classList.contains('cancel-btn')) {
            cancelOrder(orderId, this);
        } else if (this.classList.contains('return-btn')) {
            returnOrder(orderId, this);
        }
    });
});

async function cancelOrder(orderId, buttonElement) {
    const { value: reason } = await Swal.fire({
        title: 'Enter Reason for Cancellation',
        input: 'textarea',
        inputLabel: 'Cancellation Reason',
        inputPlaceholder: 'Type your reason here...',
        inputAttributes: {
            'aria-label': 'Type your reason here',
        },
        showCancelButton: true,
        confirmButtonText: 'Confirm Cancellation',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        width: '500px',
        padding: '1.5em',
        inputAutoTrim: false,
        customClass: {
            container: 'swal2-custom-container',
            input: 'swal2-custom-textarea',
            confirmButton: 'swal2-custom-confirm-btn',
            cancelButton: 'swal2-custom-cancel-btn',
        },
        preConfirm: (reason) => {
            // Validation logic
            if (!reason || reason.trim().length < 15) {
                Swal.showValidationMessage('Give proper reason to cancel this product');
                return false;
            }
            if (/^[\d\s]+$/.test(reason)) {
                Swal.showValidationMessage('Give proper reason to cancel this product');
                return false;
            }
            return reason;
        }
    });

    if (!reason) return; // User clicked cancel on SweetAlert or failed validation

    try {
        const response = await fetch('/order/order-status', {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                orderId: orderId,
                status: 'Cancelled',
                reason: reason
            }),
        });

        const result = await response.json();

        if (response.ok) {
            Swal.fire({
                icon: 'success',
                title: 'Order Cancelled',
                text: result.message,
            });
            // Update the status in the table
            document.querySelector(`.status-${orderId}`).textContent = 'Cancelled';
            // Disable the cancel button
            buttonElement.disabled = true;
            buttonElement.textContent = 'No Action';
            buttonElement.classList.remove('cancel-btn');
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Cancellation Failed',
                text: result.message,
            });
        }
    } catch (error) {
        console.error('Error:', error);
        Swal.fire({
            icon: 'error',
            title: 'Failed to Cancel',
            text: 'Failed to cancel the order.',
        });
    }
}



// Add this function to your existing JavaScript
async function returnOrder(orderId, buttonElement) {
    const { value: reason } = await Swal.fire({
        title: 'Return Reason',
        input: 'textarea',
        inputLabel: 'Please enter the reason for return:',
        inputPlaceholder: 'Enter your reason here (minimum 15 characters)...',
        showCancelButton: true,
        confirmButtonText: 'Submit',
        cancelButtonText: 'Cancel',
        customClass: {
            popup: 'large-swal-popup',
            input: 'large-swal-input'
        },
        inputValidator: (value) => {
            if (!value) {
                return 'You need to write something!';
            }
            if (value.length < 15) {
                return 'Your reason must be at least 15 characters long.';
            }
            if (/^\d+$/.test(value)) {
                return 'Please provide a proper reason, not just numbers.';
            }
        }
    });

    if (reason) {
        try {
            const response = await fetch('/order/return-request', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    orderId: orderId,
                    reason: reason
                }),
            });

            const result = await response.json();

            if (response.ok) {
                Swal.fire({
                    title: 'Success',
                    text: 'Return request submitted successfully',
                    icon: 'success',
                    customClass: {
                        popup: 'large-swal-popup'
                    }
                });
                // Update the button to show "Return Requested"
                buttonElement.textContent = 'Return Requested';
                buttonElement.disabled = true;
            } else {
                Swal.fire({
                    title: 'Error',
                    text: result.message || 'Failed to submit return request',
                    icon: 'error',
                    customClass: {
                        popup: 'large-swal-popup'
                    }
                });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                title: 'Error',
                text: 'Failed to submit return request. Please try again later.',
                icon: 'error',
                customClass: {
                    popup: 'large-swal-popup'
                }
            });
        }
    }
}

// Update your existing event listener for the return button
document.querySelectorAll('.return-btn').forEach(button => {
    button.addEventListener('click', function() {
        const orderId = this.getAttribute('data-order-id');
        returnOrder(orderId, this);
    });
});

// Close the modal when clicking on the close button
document.querySelectorAll('.close-btn').forEach(button => {
    button.addEventListener('click', () => {
        document.querySelector('#orderDetailsModal').style.display = 'none';
    });
});














</script>


