<!-- Order Details Modal -->
<div class="order-details-modal modal" id="orderDetailsModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Order Details</h3>
            <button class="close-btn">&times;</button>
        </div>
        <div class="modal-body">
            <div class="row">
                <div class="col">
                    <h4>Order Information</h4>
                    <p><strong>Order ID:</strong> <span class="order-id"></span></p>
                    <p><strong>Order Date:</strong> <span class="order-date"></span></p>
                    <p><strong>Total Amount:</strong> ₹<span class="total-amount"></span></p>
                    <p><strong>Order Status:</strong> <span class="order-status"></span></p>
                    <p><strong>Payment Type:</strong> <span class="payment-type"></span></p>
                    <p><strong>Payment Status:</strong> <span class="payment-status"></span></p>
                </div>
                <div class="col">
                    <h4>Shipping Address</h4>
                    <p><strong>Name:</strong> <span class="name"></span></p>
                    <p><strong>Street:</strong> <span class="street"></span></p>
                    <p><strong>City:</strong> <span class="city"></span>, <span class="zip"></span></p>
                    <p><strong>State:</strong> <span class="state"></span></p>
                    <p><strong>Phone:</strong> <span class="phone"></span></p>
                </div>
            </div>
            <div class="order-items">
                <h4>Order Items</h4>
                <table>
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody class="order-items-table">
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer">
            <!-- Cancel button always visible -->
            <button class="cancel-btn" style="display: none;"></button>
            <!-- Return button conditionally visible -->
            <button class="return-btn" style="display: none;"></button>
            <button class="close-btn">Close</button>
        </div>
    </div>
