<script>


// Function to handle order cancellation
async function cancelOrder(orderId, itemId, buttonElement) {
    if (!itemId) {
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Item ID is missing.',
        });
        return;
    }

    const { value: reason } = await Swal.fire({
        title: 'Enter Reason for Cancellation',
        input: 'textarea',
        inputLabel: 'Cancellation Reason',
        inputPlaceholder: 'Type your reason here...',
        inputAttributes: {
            'aria-label': 'Type your reason here',
        },
        showCancelButton: true,
        confirmButtonText: 'Confirm Cancellation',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        width: '500px',
        padding: '1.5em',
        inputAutoTrim: false,
        customClass: {
            container: 'swal2-custom-container',
            input: 'swal2-custom-textarea',
            confirmButton: 'swal2-custom-confirm-btn',
            cancelButton: 'swal2-custom-cancel-btn',
        },
        preConfirm: (reason) => {
            // Validation logic
            if (!reason || reason.trim().length < 15) {
                Swal.showValidationMessage('Give a proper reason to cancel this product');
                return false;
            }
            if (/^[\d\s]+$/.test(reason)) {
                Swal.showValidationMessage('Give a proper reason to cancel this product');
                return false;
            }
            return reason;
        }
    });

    if (!reason) return; // User clicked cancel on SweetAlert or failed validation

    try {
        const response = await fetch('/order/order-status', {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                orderId: orderId,
                itemId: itemId, // Pass the specific itemId
                status: 'Cancelled',
                reason: reason
            }),
        });

        const result = await response.json();

        if (response.ok) {
            Swal.fire({
                icon: 'success',
                title: 'Order Item Cancelled',
                text: result.message,
            });
            // Update the status in the table
            document.querySelector(`.status-${orderId}`).textContent = 'Cancelled';
            // Disable the cancel button
            buttonElement.disabled = true;
            buttonElement.textContent = 'No Action';
            buttonElement.classList.remove('cancel-btn');
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Cancellation Failed',
                text: result.message,
            });
        }
    } catch (error) {
        console.error('Error:', error);
        Swal.fire({
            icon: 'error',
            title: 'Failed to Cancel',
            text: 'Failed to cancel the order item.',
        });
    }
}

// Function to handle return request
async function returnOrder(orderId, itemId, buttonElement) {
    const { value: reason } = await Swal.fire({
        title: 'Return Reason',
        input: 'textarea',
        inputLabel: 'Please enter the reason for return:',
        inputPlaceholder: 'Enter your reason here (minimum 15 characters)...',
        showCancelButton: true,
        confirmButtonText: 'Submit',
        cancelButtonText: 'Cancel',
        customClass: {
            popup: 'large-swal-popup',
            input: 'large-swal-input'
        },
        inputValidator: (value) => {
            if (!value) {
                return 'You need to write something!';
            }
            if (value.length < 15) {
                return 'Your reason must be at least 15 characters long.';
            }
            if (/^\d+$/.test(value)) {
                return 'Please provide a proper reason, not just numbers.';
            }
        }
    });

    if (reason) {
        try {
            const response = await fetch('/order/return-request', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    orderId: orderId,
                    itemId: itemId,
                    reason: reason
                }),
            });

            const result = await response.json();

            if (response.ok) {
                Swal.fire({
                    title: 'Success',
                    text: 'Return request submitted successfully',
                    icon: 'success',
                    customClass: {
                        popup: 'large-swal-popup'
                    }
                });
                // Update the button to show "Return Requested"
                buttonElement.textContent = 'Return Requested';
                buttonElement.disabled = true;
            } else {
                Swal.fire({
                    title: 'Error',
                    text: result.message || 'Failed to submit return request',
                    icon: 'error',
                    customClass: {
                        popup: 'large-swal-popup'
                    }
                });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                title: 'Error',
                text: 'Failed to submit return request. Please try again later.',
                icon: 'error',
                customClass: {
                    popup: 'large-swal-popup'
                }
            });
        }
    }
}

// Add event listeners to all action buttons
document.querySelectorAll('.action-btn').forEach(button => {
    button.addEventListener('click', function() {
        const orderId = this.getAttribute('data-order-id');
        const itemId = this.getAttribute('data-item-id');
        console.log('Order ID:', orderId, 'Item ID:', itemId); // Debugging line

        if (this.classList.contains('return-btn')) {
            returnOrder(orderId, itemId, this);
        } else if (this.classList.contains('cancel-btn')) {
            cancelOrder(orderId, itemId, this);
        }
    });
});



// Close the modal when clicking on the close button
document.querySelectorAll('.close-btn').forEach(button => {
    button.addEventListener('click', () => {
        document.querySelector('#orderDetailsModal').style.display = 'none';
    });
});



document.addEventListener('DOMContentLoaded', function() {
    const logoutLink = document.querySelector('a[href="/logout"]');

    if (logoutLink) {
        logoutLink.addEventListener('click', function(event) {
            event.preventDefault(); // Prevent the default link behavior

            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to recover your session!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, sign out!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Redirect to the logout URL
                    window.location.href = '/logout';
                }
            });
        });
    }
});






document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.retry-btn').forEach(button => {
        button.addEventListener('click', async (e) => {
            e.preventDefault();

            const orderId = button.getAttribute('data-order-id');
            const amount = button.getAttribute('data-amount');

            try {
                // Request order details from backend
                const response = await fetch('/create-razorpay-retry-order', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ orderId, amount })
                });

                const result = await response.json();

                if (result.success) {
                    const options = {
                        key: '<%= process.env.RAZORPAY_KEY_ID %>',
                        amount: result.amount,
                        currency: result.currency,
                        name: 'Your Company Name',
                        order_id: result.orderId,
                        handler: async function (response) {
                            const verifyResponse = await fetch('/verify-razorpay-retry-payment', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({
                                    orderId,
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_signature: response.razorpay_signature
                                })
                            });

                            const verifyResult = await verifyResponse.json();

                            if (verifyResult.success) {
                                // SweetAlert for successful payment
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Payment Successful!',
                                    text: 'Your payment has been verified successfully.',
                                }).then(() => {
                                    location.reload(); // Reload the page after the alert
                                });
                            } else {
                                // SweetAlert for failed verification
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Payment Verification Failed',
                                    text: 'Please try again or contact support.',
                                });
                            }
                        },
                        prefill: {
                            name: 'Customer Name',
                            email: 'customer@example.com',
                            contact: '1234567890'
                        },
                        theme: {
                            color: '#3399cc'
                        }
                    };

                    const paymentObject = new Razorpay(options);
                    paymentObject.open();
                } else {
                    // SweetAlert for failed order creation
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed to Create Retry Order',
                        text: 'Unable to create a new order. Please try again later.',
                    });
                }
            } catch (error) {
                console.error('Error initiating payment:', error);
                // SweetAlert for error during payment initiation
                Swal.fire({
                    icon: 'error',
                    title: 'An Error Occurred',
                    text: 'An error occurred while initiating the payment. Please try again.',
                });
            }
        });
    });
});







</script>


