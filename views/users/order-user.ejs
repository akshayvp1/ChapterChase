<script>
// Function to open the modal and populate it with order details
// Function to open the order details modal
// Add event listeners to all view buttons
document.querySelectorAll('.view-btn').forEach(button => {
  button.addEventListener('click', function() {
    const orderId = this.getAttribute('data-order-id');
    openOrderDetailsModal(orderId);
  });
});
async function openOrderDetailsModal(orderId) {
  try {
    const response = await fetch(`/order/${orderId}`); // Fetch order details by ID
    const order = await response.json();

    if (response.ok) {
      // Populate the modal with order details
      document.querySelector('.order-id').textContent = order.orderId;
      document.querySelector('.order-date').textContent = new Date(order.createdAt).toLocaleDateString();
      document.querySelector('.total-amount').textContent = order.totalPrice.toFixed(2);
      document.querySelector('.order-status').textContent = order.order_status;
      document.querySelector('.payment-type').textContent = order.paymentMethod;
      document.querySelector('.payment-status').textContent = order.payment_status;
      document.querySelector('.name').textContent = order.address.addressName;
      document.querySelector('.street').textContent = `${order.address.addressHouse}, ${order.address.addressStreet}`;
      document.querySelector('.city').textContent = order.address.addressCity;
      document.querySelector('.zip').textContent = order.address.addressPin;
      document.querySelector('.state').textContent = order.address.addressState;
      document.querySelector('.phone').textContent = order.address.addressMobile;

      // Populate the order items table
      const orderItemsTable = document.querySelector('.order-items-table');
      orderItemsTable.innerHTML = '';
      order.items.forEach(item => {
        const row = document.createElement('tr');
        row.innerHTML = `
          <td>${item.product.productName}</td>
          <td>${item.quantity}</td>
          <td>₹${item.product.price}</td>
          <td>₹${item.quantity * item.product.price}</td>
        `;
        orderItemsTable.appendChild(row);
      });

      // Show or hide buttons based on order status
      const cancelBtn = document.querySelector('.cancel-btn');
      const returnBtn = document.querySelector('.return-btn');
      
      if (order.order_status === 'Delivered') {
        cancelBtn.style.display = 'none';
        returnBtn.style.display = 'block';
      } else {
        cancelBtn.style.display = 'block';
        returnBtn.style.display = 'none';
      }

      // Show the modal
      document.querySelector('#orderDetailsModal').style.display = 'block';
    } else {
      alert('Failed to fetch order details.');
    }
  } catch (error) {
    console.error('Error:', error);
    alert('Error fetching order details.');
  }
}

document.addEventListener('DOMContentLoaded', () => {
    // Handle the cancel button click
    document.querySelectorAll('.cancel-btn').forEach(button => {
        button.addEventListener('click', async () => {
            const orderId = button.getAttribute('data-order-id');

            // Show SweetAlert2 popup
            const { value: reason } = await Swal.fire({
                title: 'Cancel Order',
                input: 'textarea',
                inputLabel: 'Reason for Cancellation',
                inputPlaceholder: 'Enter the reason...',
                inputAttributes: {
                    'aria-label': 'Enter the reason for cancellation'
                },
                showCancelButton: true,
                confirmButtonText: 'Submit',
                cancelButtonText: 'Cancel',
                preConfirm: (reason) => {
               // Check if reason is provided, has at least 10 characters, does not contain numbers, and is not just spaces
               if (!reason || reason.length < 10 || /\d/.test(reason) || !/\S/.test(reason)) {
                Swal.showValidationMessage(
               'Reason must be at least 10 characters long, cannot contain numbers, and cannot be only spaces.'
                 );
                return false;
                }
               return reason;
               }
            });

            if (reason) {
                try {
                    const response = await fetch('/order/order-status', {
                        method: 'PATCH',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            orderId: orderId,
                            status: 'Cancelled',
                            reason: reason
                        }),
                    });

                    const result = await response.json();

                    if (response.ok) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Order Cancelled',
                            text: result.message,
                        }).then(() => {
                            // Optionally, refresh the order list or update the UI
                            location.reload(); // Reload to update the order status
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: result.message,
                        });
                    }
                } catch (error) {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to cancel the order.',
                    });
                }
            }
        });
    });
});




// Handle the return button click
document.querySelector('.return-btn').addEventListener('click', async () => {
  const orderId = document.querySelector('.order-id').textContent;

  try {
    const response = await fetch('/order/order-status', {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        orderId: orderId,
        status: 'Returned'
      }),
    });

    const result = await response.json();

    if (response.ok) {
      alert(result.message);
      document.querySelector('#orderDetailsModal').style.display = 'none';
      // Optionally, refresh the order list or update the UI
    } else {
      alert(result.message);
    }
  } catch (error) {
    console.error('Error:', error);
    alert('Failed to return the order.');
  }
});

// Close the modal when clicking on the close button
document.querySelectorAll('.close-btn').forEach(button => {
  button.addEventListener('click', () => {
    document.querySelector('#orderDetailsModal').style.display = 'none';
  });
});


</script>


