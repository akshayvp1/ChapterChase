                                <table class="order-table">
                                    <thead>
                                        <tr>
                                            <th>Order ID</th>
                                            <th>Address Name</th>
                                            <th>Price</th>
                                            <th>Status</th>
                                            <th>View</th>
                                            <th>Cancel</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (orders.length === 0) { %>
                                            <tr>
                                                <td colspan="6">No orders found for this user.</td>
                                            </tr>
                                        <% } else { %>
                                            <% orders.forEach(order => { %>
                                                <tr>
                                                    <td>#<%= order.orderId %></td>
                                                    <td><%= order.address.addressName %></td>
                                                    <td>₹<%= order.items.reduce((total, item) => total + item.product.price * item.quantity, 0) %></td>
                                                    <td><%= order.order_status %></td>
                                                    <td><button class="view-btn" data-order-id="<%= order._id %>">View</button></td>
                                                    <td>
                                                        <% if (order.order_status === 'Pending') { %>
                                                            <button class="cancel-btn" data-order-id="<%= order._id %>">Cancel</button>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } %>
                                    </tbody>
                                </table>
                                
                                
                                  
                        </div><!-- End .col-lg-9 -->
                    </div><!-- End .row -->
                </div><!-- End .container -->
