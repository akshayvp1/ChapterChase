<style>
.order-details-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 800px;
  padding: 20px;
  border-color:2 px black
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #ddd;
  padding-bottom: 10px;
}

.modal-header h3 {
  margin: 0;
}

.close-btn {
  background-color: transparent;
  border: none;
  font-size: 24px;
  cursor: pointer;
}

.modal-body {
  padding: 20px 0;
}

.row {
  display: flex;
  justify-content: space-between;
}

.col {
  flex-basis: 48%;
}

.order-items {
  margin-top: 20px;
}

.order-items table {
  width: 100%;
  border-collapse: collapse;
}

.order-items th,
.order-items td {
  padding: 10px;
  text-align: left;
  border-bottom: 1px solid #ddd;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  border-top: 1px solid #ddd;
  padding-top: 10px;
}

.cancel-btn {
  background-color: #e74c3c;
  color: #fff;
  border: none;
  padding: 8px 16px;
  border-radius: 4px;
  cursor: pointer;
  margin-right: 10px;
}

.close-btn {
  background-color: #2ecc71;
  color: #fff;
  border: none;
  padding: 8px 16px;
  border-radius: 4px;
  cursor: pointer;
}

.order-info p,
.shipping-address p {
  margin-left: 10px;
}
.order{
    margin-left: 40px;
}
.col{
    margin-left: 40px;
}
.order-items{
    margin-left: 40px;
}
.modal-header h3{
    margin-left: 250px;
}









    .order-table {
  width: 100%;
  border-collapse: collapse;
}

.order-table th,
.order-table td {
  padding: 10px;
  text-align: left;
  border: 1px solid #000000;
  
}

.order-table th {
  background-color: #62b8b8;
}

.view-btn {
  background-color: #4CAF50;
  color: white;
  border: none;
  padding: 8px 16px;
  text-align: center;
  text-decoration: none;
  display: inline-block;
  font-size: 14px;
  cursor: pointer;
}
</style>


