                                                                        <tr>
                                                                            <td>#<%= order.orderId %></td>
                                                                            <td><img src="/assets/uploads/<%= pro.product.images[1] %>" alt="" class="product-image"></td>
                                                                            <td><%= pro.quantity %></td>
                                                                            <td>₹<%= (pro.price / pro.quantity).toFixed(2) %></td>
                                                                            <td class="status status-<%= order._id %>"><%= pro.order_status %></td>
                                                                            <td class="actions">
                                                                                <% if (retryItems.length > 0) { %>
                                                                                    <% if (['Pending', 'Processing', 'Shipped'].includes(pro.order_status)) { %>
                                                                                        <!-- Removed No Action Button -->
                                                                                    <% } else if (pro.order_status === 'Delivered') { %>
                                                                                        <!-- Removed No Action Button -->
                                                                                    <% } %>
                                                                                <% } else { %>
                                                                                    <% if (pro.order_status === 'Pending' || pro.order_status === 'Processing') { %>
                                                                                        <button class="action-btn cancel-btn" data-order-id="<%= order._id %>" data-item-id="<%= pro._id %>">Cancel</button>
                                                                                    <% } else if (pro.order_status === 'Delivered') { %>
                                                                                        <button class="action-btn return-btn" data-order-id="<%= order._id %>" data-item-id="<%= pro._id %>">Return</button>
                                                                                    <% } else { %>
                                                                                        <button class="action-btn" disabled>No Action</button>     
                                                                                    <% } %>
                                                                                <% } %>
                                                                            </td>
                                                                            <td>
                                                                                <% if (pro.order_status === 'Delivered') { %>
                                                                                    <a href="/invoice?orderId=<%= order.orderId %>&productId=<%= pro.product._id %>" class="action-btn invoice-btn">
                                                                                        <i class="fas fa-file-invoice"></i> Download Invoice
                                                                                    </a>
                                                                                <% } %>
                                                                            </td>
                                                                        </tr>
                                                                    <% }); %>
                        
                                                                    <% if (retryItems.length > 0) { %>
                                                                        <tr>
                                                                            <td colspan="7" class="text-center">
                                                                                <a href="#" class="retry-btn" data-order-id="<%= order.orderId %>" data-amount="<%= order.totalPrice %>">Retry Payment</a>
                                                                            </td>
                                                                        </tr>
                                                                    <% } %>
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                <% }); %>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </div><!-- End .col-lg-9 -->
                        
                        
                        
                        
                        
                        </div><!-- End .row -->
                        
                        
                        
