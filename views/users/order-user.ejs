    .search-container {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    /* Search input styling */
    .search-input {
        padding: 10px;
        font-size: 14px;
        width: 300px;
        border-radius: 5px;
        border: 1px solid #ccc;
        outline: none;
        margin-right: 10px;
    }

    /* Focused input with shadow */
    .search-input:focus {
        border-color: #007bff;
        box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
    }

    /* Search button styling */
    .search-btn {
        padding: 10px 20px;
        font-size: 14px;
        border-radius: 5px;
        background-color: #007bff;
        color: white;
        border: none;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    /* Hover effect for the search button */
    .search-btn:hover {
        background-color: #0056b3;
    }

    /* Additional optional styles for the table */
    .order-table {
        width: 100%;
        border-collapse: collapse;
    }

    .order-table th, .order-table td {
        padding: 10px;
        border: 1px solid #ddd;
        text-align: left;
    }

    /* Pagination list styling */
    .pagination-list {
        list-style: none;
        display: flex;
        justify-content: center;
        padding: 0;
    }

    .pagination-list li {
        margin: 0 5px;
    }

    .pagination-list li a {
        padding: 5px 10px;
        border: 1px solid #007bff;
        color: #007bff;
        text-decoration: none;
        border-radius: 5px;
    }

    .pagination-list li a:hover {
        background-color: #007bff;
        color: white;
    }

    .pagination-list li.active a {
        background-color: #007bff;
        color: white;
    }









.pagination {
    display: flex;
    justify-content: center; /* Center the pagination */
    margin: 20px 0;
}
.pagination-list {
    list-style: none;
    padding: 0;
    display: flex;
    justify-content: center; /* Center the list items */
}
.pagination-list li {
    display: inline-block;
    margin: 0 5px;
}
.pagination-list a {
    text-decoration: none;
    padding: 5px 10px;
    border: 1px solid #ccc;
    color: #007bff;
    transition: background-color 0.3s;
}
.pagination-list a:hover {
    background-color: #f1f1f1;
}
.pagination-list .active a {
    background-color: #007bff;
    color: white;
    border-color: #007bff;
}






/* Custom styles for SweetAlert2 modal */
.swal2-custom-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0;
    box-sizing: border-box;
}

.swal2-custom-textarea {
    height: 150px; /* Adjust height as needed */
    resize: vertical; /* Allow vertical resizing */
    box-sizing: border-box; /* Ensure padding and border are included in the width/height */
}

.swal2-custom-confirm-btn {
    background-color: #3085d6;
    border: none;
    color: #fff;
    font-size: 16px;
    padding: 10px 20px;
}

.swal2-custom-cancel-btn {
    background-color: #d33;
    border: none;
    color: #fff;
    font-size: 16px;
    padding: 10px 20px;
}

/* Center the modal horizontally */
.swal2-popup {
    box-sizing: border-box; /* Ensure proper width calculation */
    margin: auto;
}













