/* Container for search and table */
.search-container {
    margin-bottom: 20px;
}

/* Flex container for search form */
#search-form {
    display: flex;
    align-items: center;
}

/* Search input styles */
.search-input {
    flex: 1;
    margin-right: 10px; /* Space between input and button */
}

/* Search button styles */
.search-btn {
    flex-shrink: 0;
    padding: 8px 16px;
    font-size: 14px;
    border-radius: 4px;
    background-color: #007bff; /* Primary blue color */
    color: white;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.2s;
    margin-bottom: 17px;
}

.search-btn:hover {
    background-color: #0e0f10; /* Darker blue on hover */
    transform: scale(1.05);
}

/* Pagination styles */
.pagination {
    margin-top: 20px;
    text-align: center;
}

.pagination-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.pagination-list li {
    display: inline;
    margin: 0 5px;
}

.pagination-list a {
    text-decoration: none;
    color: #007bff; /* Primary blue color */
    padding: 8px 12px;
    border: 1px solid #007bff;
    border-radius: 4px;
    transition: background-color 0.2s, color 0.2s;
}

.pagination-list a:hover {
    background-color: #0056b3; /* Darker blue on hover */
    color: white;
}

.pagination-list .active a {
    background-color: #007bff; /* Primary blue color */
    color: white;
    border: 1px solid #007bff;
}





