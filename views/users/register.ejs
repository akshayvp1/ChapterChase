    <script>
        function validateForm() {
            const name = document.getElementById("register-name-2").value;
            const email = document.getElementById("register-email-2").value;
            const mobile = document.getElementById("register-mobile-2").value;
            const password = document.getElementById("register-password-2").value;
            const confirmPassword = document.getElementById("register-Re-Enter-password-2").value;
    
            // Regular expressions for validation
            // const emailRegex = /\S+@\S+\.\S+/;

            const emailRegex = /^[a-zA-Z0-9._%+-]+@gmail\.com$/;
            const mobileRegex = /^[6-9]\d{9}$/; // Mobile number regex (starts with 6, 7, 8, or 9 and exactly 10 digits)
            const passwordRegex = /^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[@#$%^&+=])(?=.*[a-zA-Z]).{6,10}$/; // Password regex (between 6 to 10 characters, at least one uppercase, one lowercase, one number, one special character)
    
            // Basic validations
            let isValid = true;
            if (!name.trim()) {
                document.getElementById("register-name-2").classList.add("is-invalid");
                isValid = false;
            } else {
                document.getElementById("register-name-2").classList.remove("is-invalid");
            }
            if (!email.trim() || !emailRegex.test(email)) {
                document.getElementById("register-email-2").classList.add("is-invalid");
                isValid = false;
            } else {
                document.getElementById("register-email-2").classList.remove("is-invalid");
            }
            if (!mobile.trim() || !mobileRegex.test(mobile)) {
                document.getElementById("register-mobile-2").classList.add("is-invalid");
                isValid = false;
            } else {
                document.getElementById("register-mobile-2").classList.remove("is-invalid");
            }
            if (!password.trim() || !passwordRegex.test(password)) {
                document.getElementById("register-password-2").classList.add("is-invalid");
                document.getElementById("register-password-2").classList.remove("is-valid"); // Remove valid feedback
                isValid = false;
            } else {
                document.getElementById("register-password-2").classList.remove("is-invalid");
                document.getElementById("register-password-2").classList.add("is-valid");
            }
            if (password !== confirmPassword) {
                document.getElementById("register-Re-Enter-password-2").classList.add("is-invalid");
                isValid = false;
            } else {
                document.getElementById("register-Re-Enter-password-2").classList.remove("is-invalid");
            }
    
            return isValid;
        }
    </script>
    
    <style>
        .is-invalid {
            border-color: #dc3545;
        }
        .is-invalid + .invalid-feedback {
            display: block;
            color: #dc3545;
        }
        .is-valid {
            border-color: #28a745;
        }
        .is-valid + .valid-feedback {
            display: block;
            color: #28a745;
        }
    </style>
    
