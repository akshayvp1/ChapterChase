    <div class="order-summary order-summary-container">
        <div class="order-details">
            <div class="order-info">
                <h4 class="mb-3">Order Details</h4>
                <p><strong>Order ID:</strong> #<%= order.orderId %></p>
                <p><strong>Total Amount:</strong> ₹ <%= order.totalPrice.toFixed(2) %></p>
                <p><strong>Delivery Date:</strong> <%= new Date(order.deliveryDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            </div>
            <div class="address-details">
                <h4>Address Details</h4>
                <p><strong>Ship to:</strong> <%= order.address.addressName %></p>
                <p><strong>Delivery Address</strong><br>
                    <%= order.address.addressHouse %>, <%= order.address.addressStreet %><br>
                    <%= order.address.addressCity %>, <%= order.address.addressDistrict %><br>
                    <%= order.address.addressState %>, <%= order.address.addressPin %><br>
                    <%= order.address.addressMobile %>
                </p>
            </div>
        </div>

        <h3 class="mt-4 mb-3">Products</h3>
        <table class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>NO</th>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <% order.items.forEach((item, index) => { %>
                    <% const product = item.product; %>
                    <% if (product) { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= product.productName %></td> <!-- Assuming productName exists in the Product model -->
                            <td><%= item.quantity %></td>
                            <td>₹<%= item.price/item.quantity %></td> <!-- Displaying half the price -->
                            <td>₹<%= item.price %></td> <!-- Displaying full price -->
                        </tr>
                    <% } else { %>
                        <tr>
                            <td colspan="5">Product information not available</td>
                        </tr>
                    <% } %>
                <% }); %>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4">Subtotal</td>
                    <td>₹<%= totalPrice %></td> <!-- Displaying the totalPrice -->
                </tr>
                <tr>
                    <td colspan="4"><strong>Final Total</strong></td>
                    <td><strong>₹<%= totalPrice %></strong></td> <!-- Displaying the final total price -->
                </tr>
            </tfoot>
        </table>
        
        <div class="order-summary-footer">
            <div class="row">
                <div class="col-md-12 text-right">
                    <h4 class="mt-4">Grand Total: <span>₹<%= totalPrice %></span></h4> <!-- Displaying grand total -->
                </div>
            </div>
        </div>
        

        <div class="text-center mt-4">
            <a href="/products-list" class="btn btn-md mr-2">Continue Shopping</a>
            <a href="/user-order" class="btn btn-md">Go to orderlist</a>
        </div>
    </div>
